<mxGraphModel>
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>

<!-- TITLE -->
<mxCell id="title" value="JoySafeter 快速入门 — 用户操作路径全流程" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#1a237e;" vertex="1" parent="1">
  <mxGeometry x="200" y="8" width="1200" height="38" as="geometry"/>
</mxCell>
<mxCell id="subtitle" value="从登录到查看运行结果的 9 个关键步骤" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#757575;" vertex="1" parent="1">
  <mxGeometry x="400" y="40" width="700" height="20" as="geometry"/>
</mxCell>

<!-- ============ ROW 1: STEPS 1-5 ============ -->

<!-- STEP 1: Login -->
<mxCell id="s1" value="" style="rounded=1;whiteSpace=wrap;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=2;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="20" y="75" width="270" height="370" as="geometry"/>
</mxCell>
<mxCell id="s1h" value="&lt;b&gt;STEP 1&lt;/b&gt;  登录  /signin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565c0;fontColor=#ffffff;fontSize=12;arcSize=15;" vertex="1" parent="1">
  <mxGeometry x="30" y="85" width="250" height="30" as="geometry"/>
</mxCell>
<mxCell id="s1c" value="&lt;b&gt;邮箱 + 密码登录&lt;/b&gt;&lt;br/&gt;输入 Email / Password → Sign In&lt;br/&gt;&lt;br/&gt;&lt;b&gt;OAuth 快捷登录&lt;/b&gt;&lt;br/&gt;支持 GitHub / Google 一键授权&lt;br/&gt;&lt;br/&gt;&lt;b&gt;首次注册需验证邮箱&lt;/b&gt;&lt;br/&gt;验证邮件 → 点击链接激活&lt;br/&gt;&lt;br/&gt;&lt;b&gt;登录成功&lt;/b&gt;&lt;br/&gt;→ 自动跳转 /managed/quickstart&lt;br/&gt;&lt;br/&gt;&lt;i&gt;也支持: 忘记密码 / 重置&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=11;spacing=6;" vertex="1" parent="1">
  <mxGeometry x="30" y="123" width="250" height="312" as="geometry"/>
</mxCell>

<!-- STEP 2: Configure Models -->
<mxCell id="s2" value="" style="rounded=1;whiteSpace=wrap;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="310" y="75" width="270" height="370" as="geometry"/>
</mxCell>
        <mxCell id="s2h" value="&lt;b&gt;STEP 2&lt;/b&gt;  配置模型连接  /managed/credentials?tab=models" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7b1fa2;fontColor=#ffffff;fontSize=12;arcSize=15;" vertex="1" parent="1">
  <mxGeometry x="320" y="85" width="250" height="30" as="geometry"/>
</mxCell>
<mxCell id="s2c" value="&lt;b&gt;资源 → 密钥&lt;/b&gt;&lt;br/&gt;新建模型供应商 Secret&lt;br/&gt;&lt;br/&gt;&lt;b&gt;填写凭据&lt;/b&gt;&lt;br/&gt;Provider / API Key / Base URL&lt;br/&gt;可选默认模型名&lt;br/&gt;&lt;br/&gt;&lt;b&gt;选择默认模型密钥&lt;/b&gt;&lt;br/&gt;Agent 运行时注入容器 env&lt;br/&gt;&lt;br/&gt;&lt;b&gt;→ 模型就绪&lt;/b&gt;&lt;br/&gt;Agent 可引用当前默认凭据" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=11;spacing=6;" vertex="1" parent="1">
  <mxGeometry x="325" y="123" width="250" height="312" as="geometry"/>
</mxCell>

<!-- STEP 3: MCP Tools -->
<mxCell id="s3" value="" style="rounded=1;whiteSpace=wrap;fillColor=#e0f2f1;strokeColor=#00695c;strokeWidth=2;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="600" y="75" width="270" height="370" as="geometry"/>
</mxCell>
        <mxCell id="s3h" value="&lt;b&gt;STEP 3&lt;/b&gt;  MCP 凭据组  /managed/credentials?tab=mcp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00695c;fontColor=#ffffff;fontSize=12;arcSize=15;" vertex="1" parent="1">
  <mxGeometry x="610" y="85" width="250" height="30" as="geometry"/>
</mxCell>
<mxCell id="s3c" value="&lt;b&gt;Agent：声明 MCP 连接&lt;/b&gt;&lt;br/&gt;name / URL / transport / auth requirement&lt;br/&gt;不在 Agent 中填写密钥&lt;br/&gt;&lt;br/&gt;&lt;b&gt;凭据：保存认证材料&lt;/b&gt;&lt;br/&gt;URL 规范化后必须与 Agent 匹配&lt;br/&gt;Bearer、API Key 或自定义头加密保存&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Session：选择凭据组&lt;/b&gt;&lt;br/&gt;仅授权本次运行，required 必须唯一匹配&lt;br/&gt;&lt;br/&gt;&lt;b&gt;→ Orchestrator + Envoy&lt;/b&gt;&lt;br/&gt;Runner 不接收明文认证头" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=11;spacing=6;" vertex="1" parent="1">
  <mxGeometry x="610" y="123" width="250" height="312" as="geometry"/>
</mxCell>

<!-- STEP 4: Skills (NEW!) -->
<mxCell id="s4" value="" style="rounded=1;whiteSpace=wrap;fillColor=#fce4ec;strokeColor=#ad1457;strokeWidth=2;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="890" y="75" width="270" height="370" as="geometry"/>
</mxCell>
<mxCell id="s4h" value="&lt;b&gt;STEP 4&lt;/b&gt;  Skill 管理  /managed/skills" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ad1457;fontColor=#ffffff;fontSize=12;arcSize=15;" vertex="1" parent="1">
  <mxGeometry x="900" y="85" width="250" height="30" as="geometry"/>
</mxCell>
<mxCell id="s4c" value="&lt;b&gt;资源 → 技能&lt;/b&gt;&lt;br/&gt;导入 ZIP 或 AI 辅助创建&lt;br/&gt;&lt;br/&gt;&lt;b&gt;编辑 Skill 内容&lt;/b&gt;&lt;br/&gt;文件树 + Markdown/资源文件&lt;br/&gt;配置名称、描述、标签&lt;br/&gt;&lt;br/&gt;&lt;b&gt;安全扫描&lt;/b&gt;&lt;br/&gt;SkillSpector 默认提示风险&lt;br/&gt;可选仅在发布版本时强制&lt;br/&gt;&lt;br/&gt;&lt;b&gt;版本管理&lt;/b&gt;&lt;br/&gt;发布不可变版本并可恢复&lt;br/&gt;&lt;br/&gt;&lt;b&gt;→ Skill 就绪&lt;/b&gt;&lt;br/&gt;运行时只打包已发布版本" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=11;spacing=6;" vertex="1" parent="1">
  <mxGeometry x="900" y="123" width="250" height="312" as="geometry"/>
</mxCell>

<!-- STEP 5: Build Agent -->
<mxCell id="s5" value="" style="rounded=1;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#e65100;strokeWidth=2;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="1180" y="75" width="380" height="370" as="geometry"/>
</mxCell>
<mxCell id="s5h" value="&lt;b&gt;STEP 5&lt;/b&gt;  构建 Agent  /managed/agents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e65100;fontColor=#ffffff;fontSize=12;arcSize=15;" vertex="1" parent="1">
  <mxGeometry x="1190" y="85" width="360" height="30" as="geometry"/>
</mxCell>
<mxCell id="s5c" value="&lt;b&gt;托管智能体 → 智能体&lt;/b&gt;&lt;br/&gt;新建 Agent 或打开编辑器&lt;br/&gt;&lt;br/&gt;&lt;b&gt;基础配置&lt;/b&gt;&lt;br/&gt;名称 / 描述 / 系统提示词&lt;br/&gt;运行镜像与最大轮次&lt;br/&gt;&lt;br/&gt;&lt;b&gt;资源绑定&lt;/b&gt;&lt;br/&gt;默认模型 Secret&lt;br/&gt;Vault、Skills、Files、Memory Stores&lt;br/&gt;&lt;br/&gt;&lt;b&gt;版本快照&lt;/b&gt;&lt;br/&gt;保存草稿并发布版本&lt;br/&gt;&lt;br/&gt;&lt;b&gt;→ Agent 就绪&lt;/b&gt;&lt;br/&gt;可从 Session 或 Quickstart 运行" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=11;spacing=6;" vertex="1" parent="1">
  <mxGeometry x="1190" y="123" width="360" height="312" as="geometry"/>
</mxCell>

<!-- ============ ROW 1 ARROWS ============ -->
<mxCell id="a12" value="" style="endArrow=classic;strokeColor=#424242;strokeWidth=2;curved=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s1" target="s2">
  <mxGeometry relative="1" as="geometry"/>
</mxCell>
<mxCell id="a23" value="" style="endArrow=classic;strokeColor=#424242;strokeWidth=2;curved=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2" target="s3">
  <mxGeometry relative="1" as="geometry"/>
</mxCell>
<mxCell id="a34" value="" style="endArrow=classic;strokeColor=#424242;strokeWidth=2;curved=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3" target="s4">
  <mxGeometry relative="1" as="geometry"/>
</mxCell>
<mxCell id="a45" value="" style="endArrow=classic;strokeColor=#424242;strokeWidth=2;curved=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s4" target="s5">
  <mxGeometry relative="1" as="geometry"/>
</mxCell>

<!-- Turn arrow: Row 1 → Row 2 -->
<mxCell id="a5turn" value="&lt;b&gt;构建完成, 开始测试&lt;/b&gt;" style="endArrow=classic;strokeColor=#424242;strokeWidth=2.5;dashed=1;dashPattern=8 4;curved=1;fontSize=11;fontColor=#424242;labelBackgroundColor=#ffffff;html=1;exitX=0.15;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="s5" target="s6">
  <mxGeometry x="-0.2" relative="1" as="geometry">
    <mxPoint as="offset"/>
  </mxGeometry>
</mxCell>

<!-- ============ ROW 2: STEPS 6-9 ============ -->

<!-- STEP 6: Self-Test -->
<mxCell id="s6" value="" style="rounded=1;whiteSpace=wrap;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="20" y="520" width="370" height="370" as="geometry"/>
</mxCell>
<mxCell id="s6h" value="&lt;b&gt;STEP 6&lt;/b&gt;  自测 (Langfuse 风格 Trace)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e7d32;fontColor=#ffffff;fontSize=12;arcSize=15;" vertex="1" parent="1">
  <mxGeometry x="30" y="530" width="350" height="30" as="geometry"/>
</mxCell>
<mxCell id="s6c" value="&lt;b&gt;新建 Session&lt;/b&gt;&lt;br/&gt;在会话输入测试消息&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Session 详情展开&lt;/b&gt;&lt;br/&gt;实时事件流追踪&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Event Timeline&lt;/b&gt;&lt;br/&gt;用户消息 → 模型请求 → 工具调用 → 输出&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Event Detail&lt;/b&gt;&lt;br/&gt;Preview / Output / Metadata&lt;br/&gt;&lt;br/&gt;&lt;b&gt;实时流式 (SSE /sessions/{id}/events/stream)&lt;/b&gt;&lt;br/&gt;边执行边查看" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=11;spacing=6;" vertex="1" parent="1">
  <mxGeometry x="30" y="568" width="350" height="312" as="geometry"/>
</mxCell>

<!-- STEP 7: Publish -->
<mxCell id="s7" value="" style="rounded=1;whiteSpace=wrap;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="410" y="520" width="270" height="370" as="geometry"/>
</mxCell>
<mxCell id="s7h" value="&lt;b&gt;STEP 7&lt;/b&gt;  发布 Publish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c62828;fontColor=#ffffff;fontSize=12;arcSize=15;" vertex="1" parent="1">
  <mxGeometry x="420" y="530" width="250" height="30" as="geometry"/>
</mxCell>
<mxCell id="s7c" value="&lt;b&gt;点击 Publish 按钮&lt;/b&gt;&lt;br/&gt;创建版本化快照 v1, v2, v3&lt;br/&gt;&lt;br/&gt;&lt;b&gt;发布状态指示&lt;/b&gt;&lt;br/&gt;灰色 Publish → 绿色 Published&lt;br/&gt;修改后 → Publish Update&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Deployment History&lt;/b&gt;&lt;br/&gt;版本列表 + 回滚能力&lt;br/&gt;&lt;br/&gt;&lt;b&gt;API Access&lt;/b&gt;&lt;br/&gt;获取 REST API 端点地址&lt;br/&gt;&lt;br/&gt;&lt;b&gt;→ Agent 正式上线!&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=11;spacing=6;" vertex="1" parent="1">
  <mxGeometry x="420" y="568" width="250" height="312" as="geometry"/>
</mxCell>

<!-- STEP 8: Chat Running (NEW!) -->
<mxCell id="s8" value="" style="rounded=1;whiteSpace=wrap;fillColor=#fff8e1;strokeColor=#f57f17;strokeWidth=2;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="700" y="520" width="310" height="370" as="geometry"/>
</mxCell>
<mxCell id="s8h" value="&lt;b&gt;STEP 8&lt;/b&gt;  Quickstart 运行  /managed/quickstart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f57f17;fontColor=#ffffff;fontSize=12;arcSize=15;" vertex="1" parent="1">
  <mxGeometry x="710" y="530" width="290" height="30" as="geometry"/>
</mxCell>
<mxCell id="s8c" value="&lt;b&gt;进入 /managed/quickstart&lt;/b&gt;&lt;br/&gt;选择或创建托管 Agent&lt;br/&gt;&lt;br/&gt;&lt;b&gt;发送用户消息&lt;/b&gt;&lt;br/&gt;POST /sessions 创建会话&lt;br/&gt;POST /sessions/{id}/events 追加 user.message&lt;br/&gt;&lt;br/&gt;&lt;b&gt;流式响应&lt;/b&gt;&lt;br/&gt;SSE events/stream 实时推送&lt;br/&gt;工具调用与状态事件同步展示&lt;br/&gt;&lt;br/&gt;&lt;b&gt;资源查看&lt;/b&gt;&lt;br/&gt;文件、仓库、记忆资源随 Session 关联&lt;br/&gt;&lt;br/&gt;&lt;b&gt;会话管理&lt;/b&gt;&lt;br/&gt;历史记录进入 /managed/sessions" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=11;spacing=6;" vertex="1" parent="1">
  <mxGeometry x="710" y="568" width="290" height="312" as="geometry"/>
</mxCell>

<!-- STEP 9: Sessions -->
<mxCell id="s9" value="" style="rounded=1;whiteSpace=wrap;fillColor=#e8eaf6;strokeColor=#283593;strokeWidth=2;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="1030" y="520" width="530" height="370" as="geometry"/>
</mxCell>
<mxCell id="s9h" value="&lt;b&gt;STEP 9&lt;/b&gt;  Sessions 详情  /managed/sessions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#283593;fontColor=#ffffff;fontSize=12;arcSize=15;" vertex="1" parent="1">
  <mxGeometry x="1040" y="530" width="510" height="30" as="geometry"/>
</mxCell>
<mxCell id="s9c" value="&lt;b&gt;进入 /managed/sessions&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;筛选过滤&lt;/b&gt;&lt;br/&gt;Agent 名称 / Status (Running/Completed/Failed)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;会话列表&lt;/b&gt;&lt;br/&gt;SessionRow: 标题 / 状态 / Agent名 / 最近活动&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Details → /managed/sessions/[sessionId]&lt;/b&gt;&lt;br/&gt;Overview: 消息 → 回复 → 工具调用&lt;br/&gt;Events: 全部事件流&lt;br/&gt;Resources: 文件 / 仓库 / 记忆资源&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Tool Calls 展开&lt;/b&gt;&lt;br/&gt;工具名 / 参数 / 结果&lt;br/&gt;&lt;br/&gt;&lt;b&gt;实时 SSE /sessions/{id}/events/stream&lt;/b&gt;&lt;br/&gt;服务端事件推送状态变更" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=11;spacing=6;" vertex="1" parent="1">
  <mxGeometry x="1040" y="568" width="510" height="312" as="geometry"/>
</mxCell>

