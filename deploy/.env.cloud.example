# =============================================================================
# JoySafeter 云 PostgreSQL / 云 Redis 四服务部署环境变量示例
# =============================================================================
# 用法：
#   cd deploy
#   cp .env.cloud.example .env
#   按实际云数据库、云 Redis、域名修改后执行：
#   docker compose -f docker-compose.cloud.yml up -d frontend api orchestrator worker
# =============================================================================

# -----------------------------------------------------------------------------
# 镜像配置
# -----------------------------------------------------------------------------
DOCKER_REGISTRY=docker.io/jdopensource
BACKEND_IMAGE=joysafeter-backend
FRONTEND_IMAGE=joysafeter-frontend
IMAGE_TAG=latest
PIP_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
UV_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple

# -----------------------------------------------------------------------------
# 对外访问地址
# -----------------------------------------------------------------------------
# 用户浏览器访问前端的真实地址，生产建议配置 HTTPS 域名。
FRONTEND_URL=http://localhost:3000
# 用户浏览器访问 API 的真实地址，生产建议配置 HTTPS 域名或网关地址。
BACKEND_URL=http://localhost:8000
# API CORS 白名单，JSON 数组字符串；默认只允许 FRONTEND_URL。
CORS_ORIGINS='["http://localhost:3000"]'

# -----------------------------------------------------------------------------
# 宿主机端口映射
# -----------------------------------------------------------------------------
FRONTEND_BIND_HOST=0.0.0.0
FRONTEND_PORT_HOST=3000
API_BIND_HOST=0.0.0.0
API_PORT_HOST=8000

# orchestrator/worker HTTP 只是健康检查端口，默认不对公网开放。
ORCHESTRATOR_HEALTH_BIND_HOST=127.0.0.1
ORCHESTRATOR_HEALTH_PORT_HOST=8001
WORKER_HEALTH_BIND_HOST=127.0.0.1
WORKER_HEALTH_PORT_HOST=8002

# orchestrator gRPC 供 sandbox 容器回连；云上必须用安全组/防火墙限制来源。
JOYSAFETER_GRPC_BIND_HOST=0.0.0.0
JOYSAFETER_GRPC_PORT_HOST=9090
JOYSAFETER_GRPC_PORT=9090
JOYSAFETER_GRPC_PUBLIC_URL=http://host.docker.internal:9090

# -----------------------------------------------------------------------------
# 云 PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=your-cloud-postgres.example.com
POSTGRES_PORT=5432
POSTGRES_USER=joysafeter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=joysafeter
# 云数据库通常建议 require；如云厂商要求 verify-full，请同时配置证书挂载和应用参数。
POSTGRES_SSL=require
POSTGRES_MIN_POOL_SIZE=10
POSTGRES_MAX_POOL_SIZE=100
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# 云 Redis
# -----------------------------------------------------------------------------
# 示例：redis://:password@host:6379/0 或 rediss://:password@host:6380/0
REDIS_URL=redis://:change-me@your-cloud-redis.example.com:6379/0
REDIS_POOL_SIZE=50

# -----------------------------------------------------------------------------
# 三服务运行配置
# -----------------------------------------------------------------------------
API_WORKERS=1
JOYSAFETER_INSTANCE_ID=orchestrator-001
JOYSAFETER_EVENT_STREAM_ENABLED=true
JOYSAFETER_EVENT_STREAM_KEY=joysafeter:orchestrator:events
JOYSAFETER_EVENT_STREAM_GROUP=joysafeter-orchestrator-event-workers

# -----------------------------------------------------------------------------
# Sandbox / Agent 镜像配置
# -----------------------------------------------------------------------------
JOYSAFETER_SANDBOX_PROVIDER=docker
JOYSAFETER_SANDBOX_IMAGE=joysafeter-claudecode:latest
JOYSAFETER_IMAGE_CLAUDE=joysafeter-claudecode:latest
JOYSAFETER_IMAGE_CODEX=joysafeter-codex:latest

# orchestrator 通过宿主机 Docker socket 创建 sandbox 容器。
# 注意：Docker socket 权限很高，只能部署在可信内网主机上。
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_BIN_PATH=/usr/bin/docker

# -----------------------------------------------------------------------------
# 前端 CSP 可选配置
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CSP_NECESSARY_DOMAIN='http://localhost:* http://127.0.0.1:*'
NEXT_PUBLIC_CSP_CONNECT_SRC_EXTRA=
NEXT_PUBLIC_CSP_FRAME_SRC_EXTRA=
