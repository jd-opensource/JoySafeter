# =============================================================================
# JoySafeter 远程部署环境变量配置
# =============================================================================
# 单机部署: 所有服务（API/Worker/Orchestrator/Envoy）在同一台机器
# K8s 混合部署: API/Worker 用此文件, Orchestrator/Envoy 走 K8s YAML
#
# 配置分区标注:
#   [SHARED]        — API/Worker/Orchestrator 都需要
#   [API/WORKER]    — 只有 API 和 Worker 需要
#   [ORCHESTRATOR]  — 只有 Orchestrator 需要
#   [BUILD]         — 仅构建时需要,运行时不读
# =============================================================================


# =============================================================================
# [BUILD] 镜像配置
# =============================================================================
BACKEND_FULL_IMAGE=aisec-repo.jd.com/joysafeter/joysafeter-backend:latest
FRONTEND_FULL_IMAGE=aisec-repo.jd.com/joysafeter/joysafeter-frontend:latest
ORCHESTRATOR_RS_FULL_IMAGE=aisec-repo.jd.com/joysafeter/joysafeter-orchestrator-rs:latest
SKILLSPECTOR_FULL_IMAGE=aisec-repo.jd.com/joysafeter/joysafeter-skillspector:latest
GIT_COMMIT_SHA=unknown
PIP_INDEX_URL=https://pypi.org/simple
UV_INDEX_URL=https://pypi.org/simple
RUST_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/rust:1-bookworm
RUNTIME_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/debian:bookworm-slim


# =============================================================================
# [SHARED] 数据库 (API/Worker/Orchestrator 共用同一个 PG)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://user:password@pg-host:5432/joysafeter
POSTGRES_HOST=pg-host
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=joysafeter
#POSTGRES_SSL=require
DATABASE_POOL_SIZE=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_MAX_OVERFLOW=40
DATABASE_PGBOUNCER=false


# =============================================================================
# [SHARED] Redis (API/Worker/Orchestrator 共用同一个 Redis)
# =============================================================================
REDIS_URL=redis://:password@redis-host:6379/0
REDIS_POOL_SIZE=50


# =============================================================================
# [SHARED] 安全密钥
# =============================================================================
# 部署后不要更改,否则现有 session/token 全部失效!
# 生成: openssl rand -hex 32
SECRET_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME
# Vault 凭证加密密钥 (API 加密写入, Orchestrator 解密注入沙箱)
# 生成: openssl rand -base64 32
JOYSAFETER_VAULT_ENCRYPTION_KEY=CHANGE_ME

# Agent identity provider: none (disabled) or jd. JD fields are required for jd.
AGENT_IDENTITY_PROVIDER=none
AGENT_IDENTITY_BASE_URL=
AGENT_IDENTITY_ALLOWED_HOSTS=
AGENT_IDENTITY_COOKIE_NAME=
AGENT_IDENTITY_CONTEXT_TTL_SECONDS=300
JD_AGENT_IDENTITY_CLIENT_SECRET=
JD_AGENT_IDENTITY_CLIENT_ID=
JD_AGENT_IDENTITY_PLATFORM_ID=
JD_AGENT_IDENTITY_AUTH_TYPE=sso
JD_AGENT_IDENTITY_IDENTITY_TYPE=cookie
JD_AGENT_IDENTITY_AGENT_SCENE=cloud_sandbox_skill


# =============================================================================
# [SHARED] Redis 事件流管道 (Orchestrator 写入, Worker 消费)
# =============================================================================
JOYSAFETER_EVENT_STREAM_ENABLED=true
JOYSAFETER_EVENT_STREAM_KEY=joysafeter:orchestrator:events
JOYSAFETER_EVENT_STREAM_GROUP=joysafeter-orchestrator-event-workers
JOYSAFETER_EVENT_STREAM_MAX_LEN=100000
JOYSAFETER_EVENT_STREAM_BATCH_SIZE=100
JOYSAFETER_EVENT_STREAM_BLOCK_MS=1000
JOYSAFETER_EVENT_STREAM_FALLBACK_TO_DB=true
JOYSAFETER_REDIS_QUEUE_PREFIX=joysafeter


# =============================================================================
# [API/WORKER] 公共服务 URL
# =============================================================================
FRONTEND_URL=https://joysafeter-pre.jd.com
BACKEND_URL=https://joysafeter-api-pre.jd.com
CORS_ORIGINS=["https://joysafeter-pre.jd.com"]
BACKEND_CORS_ORIGINS=["https://joysafeter-pre.jd.com"]


# =============================================================================
# [API/WORKER] 前端配置
# =============================================================================
NEXT_PUBLIC_CSP_NECESSARY_DOMAIN=
NEXT_PUBLIC_CSP_CONNECT_SRC_EXTRA=https://joysafeter-api-pre.jd.com
NEXT_PUBLIC_CSP_FRAME_SRC_EXTRA=
NEXT_PUBLIC_EMAIL_PASSWORD_SIGNUP_ENABLED=false
NEXT_PUBLIC_MAX_UPLOAD_FILE_BYTES=314572800
DISABLE_REGISTRATION=false


# =============================================================================
# [API/WORKER] Cookie / 认证
# =============================================================================
COOKIE_DOMAIN=.jd.com
COOKIE_SECURE=false
COOKIE_SAMESITE=lax


# =============================================================================
# [API/WORKER] Identity Federation — internal JD redirect example (可选)
# =============================================================================
IDENTITY_FEDERATION_PROVIDERS=jd
IDENTITY_FEDERATION_CONFIG_PATH=
IDENTITY_FEDERATION_LOGIN_MODE=redirect
JD_CLIENT_ID=
JD_CLIENT_SECRET=
JD_AUTHORIZE_URL=
JD_USERINFO_URL=


# =============================================================================
# [API/WORKER] 存储
# =============================================================================
STORAGE_BACKEND=s3
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
#STORAGE_BACKEND=local
#STORAGE_LOCAL_PATH=/app/data/files


# =============================================================================
# [API/WORKER] 文件上传限制
# =============================================================================
JOYSAFETER_MAX_UPLOAD_FILE_BYTES=314572800


# =============================================================================
# [API/WORKER] Skill 安全扫描
# =============================================================================
SKILLSPECTOR_SOURCE_PATH=../../SkillSpector
SKILLSPECTOR_VERSION=local
SKILL_SECURITY_SCAN_ENABLED=false
SKILL_SECURITY_SCANNER_URL=http://skillspector:8010
SKILL_SECURITY_TIMEOUT_SECONDS=180
SKILL_SECURITY_FAIL_CLOSED=false
SKILL_SECURITY_NO_LLM=false
SKILL_SECURITY_BLOCK_RECOMMENDATIONS=DO_NOT_INSTALL
SKILLSPECTOR_PROVIDER=openai
SKILLSPECTOR_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
SKILLSPECTOR_SERVICE_SCAN_TIMEOUT=180
SKILLSPECTOR_SERVICE_MAX_FILES=100
SKILLSPECTOR_SERVICE_MAX_FILE_BYTES=1048576
SKILLSPECTOR_SERVICE_MAX_TOTAL_BYTES=5242880
SKILLSPECTOR_WORKERS=2
SKILLSPECTOR_LIMIT_CONCURRENCY=4
SKILLSPECTOR_CPUS=2
SKILLSPECTOR_MEM_LIMIT=2g
SKILL_IMPORT_MAX_ZIP_BYTES=20971520
SKILL_IMPORT_MAX_FILES=200
SKILL_IMPORT_MAX_FILE_BYTES=2097152
SKILL_IMPORT_MAX_TOTAL_FILE_BYTES=10485760


# =============================================================================
# [API/WORKER] 服务端口 (Docker Compose host 映射)
# =============================================================================
FRONTEND_BIND_HOST=0.0.0.0
FRONTEND_PORT_HOST=3000
BACKEND_BIND_HOST=0.0.0.0
BACKEND_PORT_HOST=8000
WORKER_HEALTH_BIND_HOST=127.0.0.1
WORKER_HEALTH_PORT_HOST=8002


# =============================================================================
# [API/WORKER] 运行时
# =============================================================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info


# =============================================================================
# [ORCHESTRATOR] gRPC 服务
# =============================================================================
JOYSAFETER_GRPC_BIND_HOST=0.0.0.0
JOYSAFETER_GRPC_PORT_HOST=9090
JOYSAFETER_GRPC_PORT=9090
# sandbox 容器连回 orchestrator 的地址
# 单机: host.docker.internal; K8s: 由 K8s provider 自动设,此值不用
JOYSAFETER_GRPC_PUBLIC_URL=http://host.docker.internal:9090
JOYSAFETER_GRPC_MAX_CONNECTIONS=2000
JOYSAFETER_GRPC_MAX_EXECUTIONS=1000
JOYSAFETER_MAX_MEMORIES_PER_STORE=2000
JOYSAFETER_SCHEDULER_BATCH_SIZE=10
RUST_LOG=info


# =============================================================================
# [ORCHESTRATOR] 实例 / 调度
# =============================================================================
JOYSAFETER_INSTANCE_ID=orchestrator-rs-001
JOYSAFETER_MAX_CONCURRENT_TASKS=500
JOYSAFETER_MAX_SCHEDULING_TASKS=300
JOYSAFETER_TASK_DEFAULT_TIMEOUT=7200
JOYSAFETER_TASK_DEFAULT_MAX_RETRIES=2


# =============================================================================
# [ORCHESTRATOR] Sandbox Provider
# =============================================================================
# 单机: docker; K8s: k8s
JOYSAFETER_SANDBOX_PROVIDER=docker
JOYSAFETER_SANDBOX_IMAGE=aisec-repo.jd.com/joysafeter/joysafeter-claudecode:latest
JOYSAFETER_IMAGE_CLAUDE=aisec-repo.jd.com/joysafeter/joysafeter-claudecode:latest
JOYSAFETER_IMAGE_CODEX=aisec-repo.jd.com/joysafeter/joysafeter-codex:latest
JOYSAFETER_IMAGE_NATIVE=aisec-repo.jd.com/joysafeter/joysafeter-native:latest
JOYSAFETER_SANDBOX_WORKSPACE_ROOT=/data/wgl/joysafeter/data/joysafeter-workspaces
JOYSAFETER_MOCK_ADAPTER=false


# =============================================================================
# [ORCHESTRATOR] Sandbox 生命周期与回收
# =============================================================================
# idle_since 触发的 idle timeout
JOYSAFETER_SANDBOX_IDLE_TIMEOUT=300
# stopped 状态的保留时间,过期后 destroy
JOYSAFETER_SANDBOX_STOPPED_TTL=3600
# Bridge 断开后判定 runner 死亡的 grace 时间 (太短误杀重连,太长占资源)
JOYSAFETER_SANDBOX_BRIDGE_DISCONNECT_GRACE=90
# Sandbox 绝对生命周期上限 (防僵尸). 0=禁用. 推荐: 21600(6h), 43200(12h)
JOYSAFETER_SANDBOX_HARD_TIMEOUT=21600
# 连续失败多少次后不再调度到该 sandbox
JOYSAFETER_SANDBOX_FAILURE_THRESHOLD=3


# =============================================================================
# [ORCHESTRATOR] Sandbox 容器加固
# =============================================================================
JOYSAFETER_SANDBOX_DROP_ALL_CAPS=true
JOYSAFETER_SANDBOX_NO_NEW_PRIVILEGES=true
JOYSAFETER_SANDBOX_PIDS_LIMIT=0
#JOYSAFETER_SANDBOX_RUN_AS_USER=1000:1000


# =============================================================================
# [ORCHESTRATOR] Sandbox 预热池
# =============================================================================
JOYSAFETER_SANDBOX_POOL_ENABLED=false
JOYSAFETER_SANDBOX_POOL_MIN_SIZE=0
# pool_max_age: 池 sandbox 最大存活时间(秒),过期轮换. 默认 1800(30分钟)
#JOYSAFETER_SANDBOX_POOL_MAX_AGE=1800
JOYSAFETER_SANDBOX_POOL_IMAGES=["aisec-repo.jd.com/joysafeter/joysafeter-claudecode:latest","aisec-repo.jd.com/joysafeter/joysafeter-codex:latest","aisec-repo.jd.com/joysafeter/joysafeter-native:latest"]


# =============================================================================
# [ORCHESTRATOR] Codex 引擎
# =============================================================================
JOYSAFETER_CODEX_MULTI_AGENT=false
JOYSAFETER_CODEX_SANDBOX_MODE=danger-full-access


# =============================================================================
# [ORCHESTRATOR] Envoy 网络隔离
# =============================================================================
JOYSAFETER_ENVOY_ENABLED=true
JOYSAFETER_ENVOY_IMAGE=aisec-repo.jd.com/joysafeter/joysafeter-envoy:v1.37.1
#JOYSAFETER_ENVOY_SOCKET_VOLUME=joysafeter-sockets
JOYSAFETER_ENVOY_SOCKET_HOST_DIR=/data/wgl/joysafeter/envoy/envoy-sockets
JOYSAFETER_ENVOY_CONFIG_DIR=/data/wgl/joysafeter/envoy/envoy-config
JOYSAFETER_ENVOY_NETWORK=joysafeter-network
JOYSAFETER_ENVOY_GRPC_HOST=orchestrator
JOYSAFETER_ENVOY_GRPC_PORT=9090
JOYSAFETER_ENVOY_CONTAINER_NAME=joysafeter-envoy
JOYSAFETER_ENVOY_LOG_LEVEL=info
JOYSAFETER_ENVOY_XDS_MODE=grpc
# 允许 Envoy 注入 LLM 凭证的目标主机白名单
JOYSAFETER_LLM_EGRESS_ALLOWED_HOSTS=ai-api.jdcloud.com,api.anthropic.com,api.openai.com,generativelanguage.googleapis.com,*.openai.azure.com


# =============================================================================
# [ORCHESTRATOR] Runner 控制面 Socket (单机 Docker 专用, K8s 不需要)
# =============================================================================
JOYSAFETER_RUNNER_CONTROL_SOCKET_HOST_DIR=/data/wgl/joysafeter/orchestrator/runner-control
JOYSAFETER_RUNNER_CONTROL_SOCKET_CONTAINER_PATH=/control/grpc.sock


# =============================================================================
# [ORCHESTRATOR] Docker (单机部署时连本机 Docker daemon, K8s 不需要)
# =============================================================================
DOCKER_SOCKET_PATH=/var/run/docker.sock
JOYSAFETER_STORAGE_VOLUME_HOST_PATH_ROOTS=/mnt/cfs/share/joysafeter-volumes


# =============================================================================
# [ORCHESTRATOR] 沙箱遥测禁用
# =============================================================================
# 注入到每个沙箱 env,防止 Claude Code 尝试连 api.anthropic.com 遥测
DISABLE_TELEMETRY=1


# =============================================================================
# [ORCHESTRATOR] HA 模式 (高可用)
# =============================================================================
# standalone: 单机模式 (默认,Docker Compose / 本地开发)
# leader:     主备模式 (K8s 2副本, Lease 选主, 备机待命)
# multi:      多副本无状态 (K8s N副本, Redis 协调, 全部活跃)
JOYSAFETER_HA_MODE=standalone

# --- Leader 模式配置 (仅 ha_mode=leader 时需要) ---
# 需要 K8s 集群 + RBAC 权限 (coordination.k8s.io/leases)
#JOYSAFETER_LEADER_ELECTION_ENABLED=true
#JOYSAFETER_LEADER_LEASE_NAME=joysafeter-orchestrator-leader
#JOYSAFETER_LEADER_LEASE_DURATION_SEC=10
#JOYSAFETER_LEADER_RENEW_INTERVAL_SEC=3

# --- Multi 模式配置 (仅 ha_mode=multi 时需要) ---
# 需要 Redis (REDIS_URL 必须配置)
# Orchestrator 以 Deployment 部署 (replicas: N), 通过 Redis 协调:
#   - 任务竞争消费 (BLPOP 天然分发)
#   - Bridge 注册 (Redis key + TTL)
#   - 跨实例命令转发 (Redis Streams inbox)
#   - xDS 变更广播 (Redis Streams notify)
# 无额外配置项 — 只需设置 JOYSAFETER_HA_MODE=multi 即可

# --- 实例心跳 (leader / multi 模式需要, standalone 可选) ---
# 实例在 Redis 中的存活注册, 用于跨实例发现和所有权检查
JOYSAFETER_HEARTBEAT_INTERVAL=15
JOYSAFETER_HEARTBEAT_TTL=30
