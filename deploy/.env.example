# =============================================================================
# JoySafeter 部署环境变量配置示例
# =============================================================================
# 复制此文件为 .env 并根据实际情况修改配置值
# cp .env.example .env
#
# 单机部署: 所有服务（API/Worker/Orchestrator/Frontend）在同一台机器
# =============================================================================


# =============================================================================
# 镜像配置
# =============================================================================
BACKEND_FULL_IMAGE=joysafeter-backend:latest
FRONTEND_FULL_IMAGE=joysafeter-frontend:latest
ORCHESTRATOR_RS_FULL_IMAGE=joysafeter-orchestrator-rs:latest
SKILLSPECTOR_FULL_IMAGE=joysafeter-skillspector:latest


# =============================================================================
# 公共服务 URL
# =============================================================================
# 必须为用户在浏览器中访问的真实公网绝对 URL，结尾不加斜杠！
# 影响功能: OAuth 登录回调、密码重置邮件、工作区共享链接、CORS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
BACKEND_CORS_ORIGINS=["http://localhost:3000"]


# =============================================================================
# 服务端口映射（宿主机端口）
# =============================================================================
# Docker 将容器端口映射到宿主机的端口；若端口冲突可修改

# 前端
FRONTEND_BIND_HOST=0.0.0.0
FRONTEND_PORT_HOST=3000

# API
BACKEND_BIND_HOST=0.0.0.0
BACKEND_PORT_HOST=8000

# Worker 健康检查（默认只监听 127.0.0.1，不建议公网开放）
WORKER_HEALTH_BIND_HOST=127.0.0.1
WORKER_HEALTH_PORT_HOST=8002

# Orchestrator gRPC（供 sandbox 容器访问，用安全组限制来源）
JOYSAFETER_GRPC_BIND_HOST=0.0.0.0
JOYSAFETER_GRPC_PORT_HOST=9090
JOYSAFETER_GRPC_PORT=9090

# sandbox 容器连回 orchestrator gRPC 的地址
# 单机 Docker Compose: host.docker.internal
# 分机部署: 改为 orchestrator 机器的实际 IP
JOYSAFETER_GRPC_PUBLIC_URL=http://host.docker.internal:9090


# =============================================================================
# 数据库配置 (PostgreSQL)
# =============================================================================
# 本地开发: 使用 compose 内置 PostgreSQL（profile: local-db）
# 云部署: 使用云数据库，URL-encode 密码中的特殊字符

# PostgreSQL 连接参数（compose 内置 DB 和应用程序共用）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=joysafeter
#POSTGRES_SSL=require
POSTGRES_PORT_HOST=5432

# 应用程序数据库连接 URL（优先于 POSTGRES_* 拆分参数）
# 云数据库示例: postgresql+asyncpg://user:password@cloud-host:5432/joysafeter
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/joysafeter
# 连接池大小（API/Worker/Orchestrator-RS 共用）
# 扩容沙箱容量时建议调到 50-100
DATABASE_POOL_SIZE=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_MAX_OVERFLOW=40
DATABASE_PGBOUNCER=false


# =============================================================================
# Redis 配置
# =============================================================================
# 本地开发: compose 内置 Redis（profile: local-redis）
# 云部署: 使用云 Redis，密码中 @ # : / 需 URL encode
# TLS: 使用 rediss:// 协议头
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=50
REDIS_PORT_HOST=6379


# =============================================================================
# 安全密钥
# =============================================================================
# 部署后不要更改，否则现有 session/token 全部失效！
# 生成: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Vault 凭证加密密钥（API 加密写入，Orchestrator 解密注入沙箱）
# 生成: openssl rand -base64 32
JOYSAFETER_VAULT_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# Cookie 配置（跨子域部署时必须设置 COOKIE_DOMAIN）
# 例如前端 joysafeter.jd.com + 后端 api.joysafeter.jd.com → COOKIE_DOMAIN=.jd.com
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax


# =============================================================================
# JD SSO/OAuth（可选）
# =============================================================================
JD_CLIENT_ID=
JD_CLIENT_SECRET=
JD_AUTHORIZE_URL=
JD_TOKEN_URL=
JD_USERINFO_URL=
SSO_DEFAULT_PROVIDER=jd
NEXT_PUBLIC_EMAIL_PASSWORD_SIGNUP_ENABLED=false


# =============================================================================
# 运行时配置
# =============================================================================
JOYSAFETER_INSTANCE_ID=orchestrator-001
JOYSAFETER_REDIS_QUEUE_PREFIX=joysafeter
JOYSAFETER_MAX_CONCURRENT_TASKS=500
JOYSAFETER_MAX_SCHEDULING_TASKS=300
JOYSAFETER_TASK_DEFAULT_TIMEOUT=7200
JOYSAFETER_TASK_DEFAULT_MAX_RETRIES=2

# gRPC 服务容量（Orchestrator-RS）
# 扩容时按需调大,默认值适合中小规模
JOYSAFETER_GRPC_MAX_CONNECTIONS=2000
JOYSAFETER_GRPC_MAX_EXECUTIONS=1000
JOYSAFETER_MAX_MEMORIES_PER_STORE=2000
JOYSAFETER_SCHEDULER_BATCH_SIZE=10


# =============================================================================
# Redis 事件流管道（Orchestrator 写入，Worker 消费）
# =============================================================================
JOYSAFETER_EVENT_STREAM_ENABLED=true
JOYSAFETER_EVENT_STREAM_KEY=joysafeter:orchestrator:events
JOYSAFETER_EVENT_STREAM_GROUP=joysafeter-orchestrator-event-workers
JOYSAFETER_EVENT_STREAM_MAX_LEN=100000
JOYSAFETER_EVENT_STREAM_BATCH_SIZE=100
JOYSAFETER_EVENT_STREAM_BLOCK_MS=1000
JOYSAFETER_EVENT_STREAM_FALLBACK_TO_DB=true


# =============================================================================
# Sandbox 镜像
# =============================================================================
JOYSAFETER_SANDBOX_PROVIDER=docker
JOYSAFETER_SANDBOX_IMAGE=joysafeter-claudecode:latest
JOYSAFETER_IMAGE_CLAUDE=joysafeter-claudecode:latest
JOYSAFETER_IMAGE_CODEX=joysafeter-codex:latest
JOYSAFETER_IMAGE_NATIVE=joysafeter-native:latest
JOYSAFETER_SANDBOX_WORKSPACE_ROOT=/tmp/joysafeter-workspaces


# =============================================================================
# Sandbox 生命周期与回收
# =============================================================================
# 三道独立回收条件（从快到慢）：
#   1) idle_since: runner 发了 RunnerIdle（精确「全部完成」信号）
#   2) disconnected_at: bridge gRPC stream 断了过了 grace 时间（runner 崩溃兜底）
#   3) created_at: sandbox 绝对生命周期上限（最后防线）

# idle_since 触发的 idle timeout，默认 5 分钟
JOYSAFETER_SANDBOX_IDLE_TIMEOUT=300
# stopped 状态的保留时间，过期后 destroy 容器
JOYSAFETER_SANDBOX_STOPPED_TTL=3600
# Bridge 断开后判定 runner 死亡的 grace 时间（太短误杀重连，太长占资源）
JOYSAFETER_SANDBOX_BRIDGE_DISCONNECT_GRACE=90
# Sandbox 绝对生命周期上限。0=禁用。常用值: 21600(6h), 43200(12h), 86400(24h)
JOYSAFETER_SANDBOX_HARD_TIMEOUT=21600
# 连续失败多少次后不再调度到该 sandbox
JOYSAFETER_SANDBOX_FAILURE_THRESHOLD=3


# =============================================================================
# Sandbox 容器加固
# =============================================================================
# Anthropic 官方安全指南 baseline。coding agent 以非 root 的 agent 用户跑，
# 不需要 Linux capability，这些是「纯安全收益、零运维成本」。
JOYSAFETER_SANDBOX_DROP_ALL_CAPS=true        # 应急回滚: false（允许 14 个默认 cap）
JOYSAFETER_SANDBOX_NO_NEW_PRIVILEGES=true    # 应急回滚: false（允许 setuid 提权）
JOYSAFETER_SANDBOX_PIDS_LIMIT=0              # 应急回滚: 0（不限 PID）
#JOYSAFETER_SANDBOX_RUN_AS_USER=1000:1000    # 应急回滚: 留空（用镜像默认 USER）


# =============================================================================
# Sandbox 预热池
# =============================================================================
JOYSAFETER_SANDBOX_POOL_ENABLED=true
JOYSAFETER_SANDBOX_POOL_MIN_SIZE=2
JOYSAFETER_SANDBOX_POOL_IMAGES=["joysafeter-claudecode:latest","joysafeter-codex:latest","joysafeter-native:latest"]


# =============================================================================
# Codex 引擎
# =============================================================================
# 多 Agent 模式（spawn_agent / send_message / followup_task）
JOYSAFETER_CODEX_MULTI_AGENT=false
# Codex 内部 sandbox tier。必须保持 danger-full-access:
# Docker + CapDrop=ALL 已隔离，Codex 的 Landlock/seccomp 会和 cap-drop 冲突
JOYSAFETER_CODEX_SANDBOX_MODE=danger-full-access


# =============================================================================
# Envoy 网络隔离
# =============================================================================
# 启用后 environment.networking.type=limited 才生效（仅允许 allowed_hosts）
JOYSAFETER_ENVOY_ENABLED=true
JOYSAFETER_ENVOY_IMAGE=docker.m.daocloud.io/envoyproxy/envoy:v1.37.1
JOYSAFETER_ENVOY_SOCKET_VOLUME=joysafeter-sockets
JOYSAFETER_ENVOY_CONFIG_DIR=/tmp/joysafeter-envoy-config
JOYSAFETER_ENVOY_NETWORK=joysafeter-network
# Envoy 回连 orchestrator gRPC 的地址
JOYSAFETER_ENVOY_GRPC_HOST=host.docker.internal
JOYSAFETER_ENVOY_GRPC_PORT=9090
JOYSAFETER_ENVOY_CONTAINER_NAME=joysafeter-envoy
JOYSAFETER_ENVOY_LOG_LEVEL=info
# LDS 传输方式:
#   filesystem = 写 lds.json 到 Envoy 容器（默认，O(N)）
#   grpc       = Delta xDS over orchestrator gRPC（O(1)，无文件 I/O）
JOYSAFETER_ENVOY_XDS_MODE=filesystem
# 允许 Envoy 注入 LLM 凭证的目标主机白名单
JOYSAFETER_LLM_EGRESS_ALLOWED_HOSTS=api.anthropic.com,api.openai.com,generativelanguage.googleapis.com,*.openai.azure.com


# =============================================================================
# Docker
# =============================================================================
# Orchestrator 创建 sandbox 时使用宿主机 Docker socket（Docker-outside-of-Docker）
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_BIN_PATH=/usr/bin/docker


# =============================================================================
# Skill 安全扫描
# =============================================================================
SKILLSPECTOR_SOURCE_PATH=../../SkillSpector
SKILLSPECTOR_VERSION=local
SKILL_SECURITY_SCAN_ENABLED=true
SKILL_SECURITY_SCANNER_URL=http://skillspector:8010
SKILL_SECURITY_TIMEOUT_SECONDS=30
# 扫描器故障策略: true=拒绝, false=放行（草稿保存路径代码中显式 fail-open）
SKILL_SECURITY_FAIL_CLOSED=true
SKILL_SECURITY_NO_LLM=true
SKILL_SECURITY_BLOCK_RECOMMENDATIONS=DO_NOT_INSTALL

# 扫描器服务配置
SKILLSPECTOR_SERVICE_SCAN_TIMEOUT=120
SKILLSPECTOR_SERVICE_MAX_FILES=100
SKILLSPECTOR_SERVICE_MAX_FILE_BYTES=1048576
SKILLSPECTOR_SERVICE_MAX_TOTAL_BYTES=5242880

# 扫描器并发: CPU 密集（semgrep），CPUS==WORKERS；LIMIT_CONCURRENCY 超后返回 503
SKILLSPECTOR_WORKERS=2
SKILLSPECTOR_LIMIT_CONCURRENCY=4
SKILLSPECTOR_CPUS=2
SKILLSPECTOR_MEM_LIMIT=2g

# Skill ZIP 导入限制
SKILL_IMPORT_MAX_ZIP_BYTES=20971520
SKILL_IMPORT_MAX_FILES=200
SKILL_IMPORT_MAX_FILE_BYTES=2097152
SKILL_IMPORT_MAX_TOTAL_FILE_BYTES=10485760


# =============================================================================
# 文件上传
# =============================================================================
# 单位 bytes，默认 50MB。200MB=209715200, 300MB=314572800
JOYSAFETER_MAX_UPLOAD_FILE_BYTES=52428800
# 前端浏览器侧上传限制，建议和上面保持一致
NEXT_PUBLIC_MAX_UPLOAD_FILE_BYTES=52428800


# =============================================================================
# 存储
# =============================================================================
# 单机用 local，多机用 S3/OSS
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/data/files
# S3 存储配置（取消注释启用）
# STORAGE_BACKEND=s3
# STORAGE_S3_BUCKET=CHANGE_ME
# STORAGE_S3_ENDPOINT=https://s3.example.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_ACCESS_KEY=CHANGE_ME
# STORAGE_S3_SECRET_KEY=CHANGE_ME


# =============================================================================
# 前端配置
# =============================================================================
# CSP 额外域名（API 同域名基于 BACKEND_URL 自动派生，这里只加第三方域名）
NEXT_PUBLIC_CSP_NECESSARY_DOMAIN=http://localhost:* http://127.0.0.1:*
NEXT_PUBLIC_CSP_CONNECT_SRC_EXTRA=
NEXT_PUBLIC_CSP_FRAME_SRC_EXTRA=
# 前端注册/邮件开关
DISABLE_REGISTRATION=false
EMAIL_VERIFICATION_ENABLED=false
RESEND_API_KEY=
AZURE_ACS_CONNECTION_STRING=
FROM_EMAIL_ADDRESS=
EMAIL_DOMAIN=


# =============================================================================
# 构建配置（可选）
# =============================================================================
GIT_COMMIT_SHA=unknown
PIP_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
UV_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
# 镜像源配置
#   BASE_IMAGE_REGISTRY — 官方库镜像前缀（python/node/rust/debian/postgres/redis）
#   DOCKER_MIRROR       — 第三方镜像代理前缀（envoy 等非官方库镜像）
BASE_IMAGE_REGISTRY=public.ecr.aws/docker/library/
DOCKER_MIRROR=docker.m.daocloud.io
RUST_IMAGE=public.ecr.aws/docker/library/rust:1-bookworm
RUNTIME_IMAGE=public.ecr.aws/docker/library/debian:bookworm-slim
DB_IMAGE=public.ecr.aws/docker/library/postgres:15
REDIS_IMAGE=public.ecr.aws/docker/library/redis:alpine3.22
IMAGE_TAG=latest


# =============================================================================
# 日志
# =============================================================================
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=info
RUST_LOG=info
TZ=Asia/Shanghai
