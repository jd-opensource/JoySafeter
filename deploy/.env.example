# =============================================================================
# JoySafeter 部署环境变量配置示例
# =============================================================================
# 复制此文件为 .env 并根据实际情况修改配置值
# cp .env.example .env
#
# 单机部署: 所有服务（API/Worker/Orchestrator/Frontend）在同一台机器
#
# 后端变量的完整定义和默认值见 backend/env.example（唯一真相源）。
# 前端变量的完整定义和默认值见 frontend/env.example（唯一真相源）。
# 此文件仅列出：部署必填项、与开发默认值不同的覆盖项、部署专属配置项。
# =============================================================================


# =============================================================================
# 镜像配置
# =============================================================================
BACKEND_FULL_IMAGE=joysafeter-backend:latest
FRONTEND_FULL_IMAGE=joysafeter-frontend:latest
ORCHESTRATOR_RS_FULL_IMAGE=joysafeter-orchestrator-rs:latest
SKILLSPECTOR_FULL_IMAGE=joysafeter-skillspector:latest


# =============================================================================
# 公共服务 URL
# =============================================================================
# 必须为用户在浏览器中访问的真实公网绝对 URL，结尾不加斜杠！
# 影响功能: OAuth 登录回调、密码重置邮件、工作区共享链接、CORS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
BACKEND_CORS_ORIGINS=["http://localhost:3000"]


# =============================================================================
# 服务端口映射（宿主机端口）
# =============================================================================
# Docker 将容器端口映射到宿主机的端口；若端口冲突可修改

# 前端
FRONTEND_BIND_HOST=0.0.0.0
FRONTEND_PORT_HOST=3000

# API
BACKEND_BIND_HOST=0.0.0.0
BACKEND_PORT_HOST=8000

# Worker 健康检查（默认只监听 127.0.0.1，不建议公网开放）
WORKER_HEALTH_BIND_HOST=127.0.0.1
WORKER_HEALTH_PORT_HOST=8002

# Orchestrator gRPC（供 sandbox 容器访问，用安全组限制来源）
JOYSAFETER_GRPC_BIND_HOST=0.0.0.0
JOYSAFETER_GRPC_PORT_HOST=9090


# =============================================================================
# 数据库配置 (PostgreSQL) — 覆盖 backend/env.example 的开发默认值
# =============================================================================
# Docker 环境用服务名 "postgres" 而非 localhost
POSTGRES_HOST=postgres
POSTGRES_PORT_HOST=5432

# 应用程序数据库连接 URL（优先于 POSTGRES_* 拆分参数）
# 云数据库示例: postgresql+asyncpg://user:password@cloud-host:5432/joysafeter
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/joysafeter


# =============================================================================
# Redis 配置 — 覆盖 backend/env.example 的开发默认值
# =============================================================================
# Docker 环境用服务名 "redis" 而非 localhost
REDIS_URL=redis://redis:6379/0
REDIS_PORT_HOST=6379


# =============================================================================
# 安全密钥（必填！）
# =============================================================================
# 部署后不要更改，否则现有 session/token 全部失效！
# 生成: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Vault 凭证加密密钥（API 加密写入，Orchestrator 解密注入沙箱）
# 生成: openssl rand -base64 32
JOYSAFETER_VAULT_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
# 轮换阶段可选。先加入新旧 key、执行 canary 初始化，再设置写 key；旧变量须保留到重包裹完成。
JOYSAFETER_CREDENTIAL_ENCRYPTION_KEYRING=
JOYSAFETER_CREDENTIAL_ENCRYPTION_WRITE_KEY_ID=

# Agent identity provider: none (disabled) or jd. JD fields are required for jd.
AGENT_IDENTITY_PROVIDER=none
AGENT_IDENTITY_BASE_URL=
# Comma-separated exact hosts and explicit wildcards such as *.trusted.example.com
AGENT_IDENTITY_ALLOWED_HOSTS=
AGENT_IDENTITY_COOKIE_NAME=
AGENT_IDENTITY_CONTEXT_TTL_SECONDS=300
JD_AGENT_IDENTITY_CLIENT_SECRET=
JD_AGENT_IDENTITY_CLIENT_ID=
JD_AGENT_IDENTITY_PLATFORM_ID=
JD_AGENT_IDENTITY_AUTH_TYPE=sso
JD_AGENT_IDENTITY_IDENTITY_TYPE=cookie
JD_AGENT_IDENTITY_AGENT_SCENE=cloud_sandbox_skill

# Cookie 配置（跨子域部署时必须设置 COOKIE_DOMAIN）
# 例如前端 joysafeter.jd.com + 后端 api.joysafeter.jd.com → COOKIE_DOMAIN=.jd.com
COOKIE_DOMAIN=


# =============================================================================
# Identity Federation — 默认关闭（本地开发用邮箱密码登录）
# 启用 JD SSO：PROVIDERS 设为 jd、LOGIN_MODE 设为 redirect，并填好下方 JD_* 四项
# =============================================================================
IDENTITY_FEDERATION_PROVIDERS=
IDENTITY_FEDERATION_CONFIG_PATH=
IDENTITY_FEDERATION_LOGIN_MODE=chooser
JD_CLIENT_ID=
JD_CLIENT_SECRET=
JD_AUTHORIZE_URL=
JD_USERINFO_URL=


# =============================================================================
# 运行时配置 — 覆盖 backend/env.example 的开发默认值
# =============================================================================
# 部署环境提高并发上限
JOYSAFETER_MAX_CONCURRENT_TASKS=500
JOYSAFETER_MAX_SCHEDULING_TASKS=300

# gRPC 服务容量（Orchestrator-RS）
JOYSAFETER_GRPC_MAX_CONNECTIONS=2000
JOYSAFETER_GRPC_MAX_EXECUTIONS=1000
JOYSAFETER_MAX_MEMORIES_PER_STORE=2000
JOYSAFETER_SCHEDULER_BATCH_SIZE=10


# =============================================================================
# Sandbox 生命周期 — 覆盖 backend/env.example 的开发默认值
# =============================================================================
# stopped 状态保留时间（部署环境更长，便于排查问题）
JOYSAFETER_SANDBOX_STOPPED_TTL=3600


# =============================================================================
# Sandbox 容器加固
# =============================================================================
# Anthropic 官方安全指南 baseline。coding agent 以非 root 的 agent 用户跑，
# 不需要 Linux capability，这些是「纯安全收益、零运维成本」。
JOYSAFETER_SANDBOX_DROP_ALL_CAPS=true        # 应急回滚: false（允许 14 个默认 cap）
JOYSAFETER_SANDBOX_NO_NEW_PRIVILEGES=true    # 应急回滚: false（允许 setuid 提权）
JOYSAFETER_SANDBOX_PIDS_LIMIT=256            # 应急回滚: 0（不限 PID）；与 backend 默认一致
#JOYSAFETER_SANDBOX_RUN_AS_USER=1000:1000    # 应急回滚: 留空（用镜像默认 USER）

# Runner 共享同一二进制；每个 provider 使用只包含对应 harness/entrypoint 的薄镜像。
JOYSAFETER_SANDBOX_IMAGE=joysafeter-claudecode:latest
JOYSAFETER_IMAGE_CLAUDE=joysafeter-claudecode:latest
JOYSAFETER_IMAGE_CODEX=joysafeter-codex:latest
JOYSAFETER_IMAGE_NATIVE=joysafeter-native:latest
JOYSAFETER_IMAGE_PI=joysafeter-pi:latest


# =============================================================================
# Sandbox 预热池 — 覆盖 backend/env.example 的开发默认值
# =============================================================================
# 部署环境启用预热池
JOYSAFETER_SANDBOX_POOL_ENABLED=true
JOYSAFETER_SANDBOX_POOL_IMAGES=["joysafeter-claudecode:latest","joysafeter-codex:latest","joysafeter-native:latest","joysafeter-pi:latest"]


# =============================================================================
# Envoy 网络隔离 — 覆盖 backend/env.example 的开发默认值
# =============================================================================
# 部署环境启用 Envoy 网络隔离
JOYSAFETER_ENVOY_ENABLED=true
JOYSAFETER_ENVOY_IMAGE=docker.m.daocloud.io/envoyproxy/envoy:v1.37.1
JOYSAFETER_ENVOY_NETWORK=joysafeter-network
JOYSAFETER_ENVOY_LOG_LEVEL=info
JOYSAFETER_ENVOY_XDS_MODE=grpc
JOYSAFETER_ENVOY_WRITE_DEBUG_ENTRIES=false
JOYSAFETER_ENVOY_SOCKET_SUBPATH_MOUNT=true
# Envoy 与 orchestrator 同在 joysafeter-network：ADS(xDS gRPC)必须用容器名直连。
# 代码默认 host.docker.internal 只适用于宿主机侧回连，在本网络内会解析到 VM 网关连不上，
# 导致 Envoy 0 listener、沙箱 egress socket 永不就绪。（k8s 用各自 manifest 的 service 名。）
JOYSAFETER_ENVOY_GRPC_HOST=joysafeter-orchestrator
# 沙箱 egress socket 存储。默认(推荐)使用 named volume：orchestrator 在
# `joysafeter-sockets` 卷里为每个沙箱建 <sandbox>/ 目录并以 subpath 挂进沙箱，
# compose 里 Envoy 也挂同一个卷到 /sockets（三方必须同一存储，否则 Envoy 在别的
# 文件系统上 bind listener pipe → `cannot bind .../http.sock`，egress 静默失效）。
# 保持 JOYSAFETER_ENVOY_SOCKET_HOST_DIR 不设置即用 volume 模式。
# 仅当你确实要用宿主机 bind 目录时才设置它——此时必须同步把 compose 里 Envoy 的
# /sockets 挂载改回该 bind 目录，否则会与卷模式冲突（启动自检会直接报错拦截）。
# JOYSAFETER_ENVOY_SOCKET_HOST_DIR=/tmp/joysafeter-sockets
JOYSAFETER_ENVOY_HEALTH_CHECK_INTERVAL_SEC=30
JOYSAFETER_ENVOY_HEALTH_FAILURE_THRESHOLD=3


# =============================================================================
# Docker
# =============================================================================
# Orchestrator 创建 sandbox 时使用宿主机 Docker socket（Docker-outside-of-Docker）
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_BIN_PATH=/usr/bin/docker


# =============================================================================
# Skill 安全扫描 — 覆盖 backend/env.example 的开发默认值
# =============================================================================
SKILLSPECTOR_SOURCE_PATH=../../SkillSpector
SKILLSPECTOR_VERSION=local
# 部署环境启用安全扫描
SKILL_SECURITY_SCAN_ENABLED=true
# 默认仅提示风险；切为 true 后只在发布版本时强制扫描通过
SKILL_SECURITY_SCAN_ENFORCEMENT_ENABLED=false

# 扫描器服务配置
SKILLSPECTOR_SERVICE_SCAN_TIMEOUT=120
SKILLSPECTOR_SERVICE_MAX_FILES=100
SKILLSPECTOR_SERVICE_MAX_FILE_BYTES=1048576
SKILLSPECTOR_SERVICE_MAX_TOTAL_BYTES=5242880

# 扫描器并发: CPU 密集（semgrep），CPUS==WORKERS；LIMIT_CONCURRENCY 超后返回 503
SKILLSPECTOR_WORKERS=2
SKILLSPECTOR_LIMIT_CONCURRENCY=4
SKILLSPECTOR_CPUS=2
SKILLSPECTOR_MEM_LIMIT=2g


# =============================================================================
# 文件上传 / 存储 — 覆盖 backend/env.example 的开发默认值
# =============================================================================
# 容器内路径（backend 开发默认 data/files）
STORAGE_LOCAL_PATH=/app/data/files
# 平台存储卷允许的宿主机根目录；Docker volume host_path 必须在这些目录下
JOYSAFETER_STORAGE_VOLUME_HOST_PATH_ROOTS=/mnt/joysafeter/storage
# 前端浏览器侧上传限制，建议和 JOYSAFETER_MAX_UPLOAD_FILE_BYTES 保持一致
NEXT_PUBLIC_MAX_UPLOAD_FILE_BYTES=52428800

# S3 存储配置（取消注释启用）
# STORAGE_BACKEND=s3
# STORAGE_S3_BUCKET=CHANGE_ME
# STORAGE_S3_ENDPOINT=https://s3.example.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_ACCESS_KEY=CHANGE_ME
# STORAGE_S3_SECRET_KEY=CHANGE_ME


# =============================================================================
# 前端配置（覆盖层）
# =============================================================================
# 前端环境变量的完整定义和默认值见 frontend/env.example（唯一真相源）。

# CSP 基础允许域名（生产环境替换为实际域名）
NEXT_PUBLIC_CSP_NECESSARY_DOMAIN=http://localhost:* http://127.0.0.1:*

# 登录页是否显示邮箱/密码注册入口（生产 SSO-only 环境改为 false）
NEXT_PUBLIC_EMAIL_PASSWORD_SIGNUP_ENABLED=true


# =============================================================================
# 构建配置（可选）
# =============================================================================
PIP_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
UV_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
# 镜像源配置
#   BASE_IMAGE_REGISTRY — 官方库镜像前缀（python/node/rust/debian/postgres/redis）
#   DOCKER_MIRROR       — 第三方镜像代理前缀（envoy 等非官方库镜像）
BASE_IMAGE_REGISTRY=public.ecr.aws/docker/library/
DOCKER_MIRROR=docker.m.daocloud.io
RUST_IMAGE=public.ecr.aws/docker/library/rust:1-bookworm
RUNTIME_IMAGE=public.ecr.aws/docker/library/debian:bookworm-slim
DB_IMAGE=public.ecr.aws/docker/library/postgres:15
REDIS_IMAGE=public.ecr.aws/docker/library/redis:alpine3.22
IMAGE_TAG=latest


# =============================================================================
# 日志 — 覆盖 backend/env.example 的开发默认值
# =============================================================================
DEBUG=false
LOG_LEVEL=info
RUST_LOG=info
TZ=Asia/Shanghai
