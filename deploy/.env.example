# =============================================================================
# Docker Compose 环境变量配置示例
# =============================================================================
# 复制此文件为 .env 并根据实际情况修改配置值
# cp .env.example .env
# =============================================================================
#
# 注意：此文件中的环境变量用于 Docker Compose 解析 docker-compose.yml 时使用
# 这些变量主要用于端口映射配置，与 backend/.env 中的容器内环境变量不同
#
# Docker Compose 会自动读取同目录下的 .env 文件来解析 docker-compose.yml 中的变量
# =============================================================================

# -----------------------------------------------------------------------------
# 服务端口映射配置（宿主机端口）
# -----------------------------------------------------------------------------
# 这些端口是 Docker 将容器端口映射到宿主机的端口
# 如果宿主机端口被占用，可以修改这些值以避免端口冲突

# API 服务端口映射
BACKEND_PORT_HOST=8000
BACKEND_BIND_HOST=0.0.0.0
BACKEND_URL=http://localhost:8000  # 后端服务供前端和浏览器访问的公共 URL（若部署线上或 HTTPS，请修改为如 https://api.yourdomain.com）

# Orchestrator / Worker 服务端口映射（三服务容器化部署）
# HTTP 健康检查端口默认只监听宿主机 127.0.0.1，不建议对公网开放。
ORCHESTRATOR_HEALTH_BIND_HOST=127.0.0.1
ORCHESTRATOR_HEALTH_PORT_HOST=8001
WORKER_HEALTH_BIND_HOST=127.0.0.1
WORKER_HEALTH_PORT_HOST=8002

# Orchestrator gRPC 端口供 sandbox 容器访问。云上部署请用安全组/防火墙限制来源，不建议公网开放。
JOYSAFETER_GRPC_BIND_HOST=0.0.0.0
JOYSAFETER_GRPC_PORT_HOST=9090
JOYSAFETER_GRPC_PORT=9090
# sandbox 容器连接 orchestrator gRPC 的地址。
# Docker-outside-of-Docker 场景下 sandbox 是宿主机 Docker daemon 创建的 sibling container，通常用 host.docker.internal 回连宿主机映射端口。
JOYSAFETER_GRPC_PUBLIC_URL=http://host.docker.internal:9090

# Orchestrator 容器创建 sandbox 容器时使用宿主机 Docker socket（Docker-outside-of-Docker）。
# 注意：挂载 Docker socket 权限很高，orchestrator 只能部署在可信内网主机上。
DOCKER_SOCKET_PATH=/var/run/docker.sock
# 宿主机 Docker CLI 路径；Linux 通常为 /usr/bin/docker，macOS 本地测试可改为 /usr/local/bin/docker 或 $(which docker)。
DOCKER_BIN_PATH=/usr/bin/docker

# 前端服务端口映射
FRONTEND_PORT_HOST=3000

# =============================================================================
# 前后端集成配置 (Integration) - 极度重要 ⚠️
# =============================================================================
# 必须为用户在浏览器中访问前端的真实公网绝对 URL，结尾不要加斜杠！
# 错误示范: http://frontend:3000 或 /api 或 https://domain.com/
# 影响功能: OAuth 登录回调、密码重置邮件的内链、工作区共享链接拼接、健康检查
FRONTEND_URL=http://localhost:3000

# 数据库端口映射
POSTGRES_PORT_HOST=5432

# Redis 端口映射（必需）
# 注意：Redis 是系统必需组件，用于缓存和会话管理
# 后端服务依赖 Redis，必须启动 Redis 服务才能正常运行
REDIS_PORT_HOST=6379

# MCP Server 端口映射
DEMO_MCP_SERVER_PORT=8001
SCANNER_MCP_PORT=8002
JEB_MCP_PORT=8008
MCP_PORT_3=8003
MCP_PORT_4=8004
MCP_PORT_5=8005

# -----------------------------------------------------------------------------
# 数据库与缓存配置
# -----------------------------------------------------------------------------
# 注意: docker-compose.yml 内部会使用这里的值来搭建和连接容器化服务

# PostgreSQL 数据库分配的内部帐号和数据库名称
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=joysafeter

# Redis 连接信息 (Docker 内部)
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# 三服务运行配置
# -----------------------------------------------------------------------------
API_WORKERS=1
JOYSAFETER_INSTANCE_ID=orchestrator-001
JOYSAFETER_EVENT_STREAM_ENABLED=true
JOYSAFETER_EVENT_STREAM_KEY=joysafeter:orchestrator:events
JOYSAFETER_EVENT_STREAM_GROUP=joysafeter-orchestrator-event-workers

# -----------------------------------------------------------------------------
# 构建配置（可选）
# -----------------------------------------------------------------------------
# pip 镜像源配置（默认使用清华大学镜像源，可切换到国内镜像）
PIP_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
UV_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
