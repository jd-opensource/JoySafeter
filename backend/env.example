# =============================================================================
# JoySafeter - 环境变量配置示例
# =============================================================================
# 复制此文件为 .env 并根据实际情况修改配置值
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 应用基础配置
# -----------------------------------------------------------------------------
APP_NAME="JoySafeter"
DEBUG=true
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# 服务器配置
# -----------------------------------------------------------------------------
# 应用服务器配置（容器内部配置）
# 注意：这些是应用在容器内部监听的配置，与下面的 Docker Compose 端口映射配置不同
BACKEND_PORT=8000          # 应用监听端口（容器内端口，通常不需要修改）
RUNNER_HTTP_HOST=127.0.0.1 # runner HTTP 健康检查端口监听地址；云虚拟机建议只监听本机
WORKER_HTTP_HOST=127.0.0.1 # worker HTTP 健康检查端口监听地址；云虚拟机建议只监听本机
RELOAD=false               # 生产环境应设置为 false
WORKERS=1                  # 工作进程数；runner/worker 必须保持 1，API 可按需调大或横向扩容
# 服务角色：all=本地单体兼容模式，api=HTTP/WebSocket，runner=gRPC/Scheduler，worker=后台任务
JOYSAFETER_SERVICE_ROLE=all
# 三服务 Docker 覆盖文件会按服务设置 BACKEND_APP_MODULE：
#   api    -> app.joysafeter_api.main:app
#   runner -> app.joysafeter_orchestrator.main:app
#   worker -> app.joysafeter_worker.main:app
# 旧单体兼容入口仍可临时使用 app.main:app；新部署建议使用显式服务入口。
# BACKEND_APP_MODULE=app.joysafeter_api.main:app
# API_WORKERS=1

# JoySafeter 事件流：三服务模式建议开启，让 runner 写 Redis Stream、worker 消费落库
JOYSAFETER_EVENT_STREAM_ENABLED=false
JOYSAFETER_EVENT_STREAM_KEY=joysafeter:orchestrator:events
JOYSAFETER_EVENT_STREAM_GROUP=joysafeter-orchestrator-event-workers
JOYSAFETER_EVENT_STREAM_MAX_LEN=100000
JOYSAFETER_EVENT_STREAM_BATCH_SIZE=100
JOYSAFETER_EVENT_STREAM_BLOCK_MS=1000
JOYSAFETER_EVENT_STREAM_FALLBACK_TO_DB=true
JOYSAFETER_EVENT_STREAM_PENDING_IDLE_MS=60000

# Runner gRPC：沙箱容器需要访问该端口；云安全组/防火墙不要向公网开放 9090
JOYSAFETER_GRPC_HOST=0.0.0.0
JOYSAFETER_GRPC_PORT=9090

# -----------------------------------------------------------------------------
# 认证与安全配置

# -----------------------------------------------------------------------------
# JWT 密钥 (生产环境必须修改为强随机字符串)
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production-CHANGE-THIS-IN-PRODUCTION

# JWT 算法
JWT_ALGORITHM=HS256

# Token 过期时间
ACCESS_TOKEN_EXPIRE_MINUTES=4320
REFRESH_TOKEN_EXPIRE_DAYS=30

# 认证相关配置
DISABLE_AUTH=false
REQUIRE_EMAIL_VERIFICATION=false

# Cookie 配置
COOKIE_NAME=auth_token
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# CORS 配置
# -----------------------------------------------------------------------------
# CORS 允许的源（用于跨域请求）
# 格式: JSON 数组字符串，例如: ["http://localhost:3000"]
# 生产环境示例: ["https://joysafeter.yourdomain.com"]
# 注意：在 Docker Compose 部署环境中，如果不明确设置，docker-compose.yml
# 会自动设置其允许 FRONTEND_URL 跨域，无需在此处重复配置。
# 若需添加多个源，请取消注释并配置该值：
# CORS_ORIGINS=["http://localhost:3000", "https://another-domain.com"]


# =============================================================================
# 前后端集成配置 (Integration)
# =============================================================================
# 前端 URL (用于邮件链接、密码重置、OAuth 回调等)
# ⚠️ 必须为用户在浏览器中访问前端的真实公网绝对 URL，结尾不要加斜杠！
# 错误示范: http://frontend:3000 或 /api 或 https://domain.com/
# 影响功能: OAuth 登录回调、密码重置邮件的内链、工作区共享链接拼接
# 注意：在 Docker Compose 部署环境中，此项由 docker-compose.yml 自动从
# deploy/.env 加载，所以如果是 docker container 部署，此处无需配置。
# 在本地直接运行应用（非容器化），请取消注释并配置真实的值。
# FRONTEND_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# 邮件/SMTP 配置
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@joysafeter.ai
FROM_NAME=JoySafeter

# -----------------------------------------------------------------------------
# 限流配置
# -----------------------------------------------------------------------------
RATE_LIMIT_RPM=60
RATE_LIMIT_RPH=1000

# -----------------------------------------------------------------------------
# 并发控制
# -----------------------------------------------------------------------------
MAX_CONCURRENT_LLM_CALLS=50
MAX_CONCURRENT_PER_USER=5

# -----------------------------------------------------------------------------
# 数据库与 Redis 连接池
# -----------------------------------------------------------------------------
# 注意：如果使用多个 WORKERS，每个 worker 都会创建自己的连接池。
# 生产环境请按 Postgres/Redis 最大连接数一起核算，避免实例数 * pool 过大。
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
REDIS_POOL_SIZE=50

# PgBouncer 连接池（生产环境推荐开启）
# 开启后 SQLAlchemy 使用 NullPool + 禁用 prepared statements，让 PgBouncer 管理连接。
# 需配合 PgBouncer 服务使用，将 POSTGRES_HOST 指向 PgBouncer 地址，POSTGRES_PORT 改为 6432。
# 效果：10 个服务实例共享 50 个 PG 连接（而非各自 20 个 = 200 个）。
PGBOUNCER_ENABLED=false
# POSTGRES_HOST=pgbouncer
# POSTGRES_PORT=6432

# -----------------------------------------------------------------------------
# JoySafeter 编排与高并发配置
# -----------------------------------------------------------------------------
# 单实例最大 running task 数。集群总并发约等于实例数 * 该值，实际还受
# sandbox provider、模型限流、DB 写入能力和事件广播能力影响。
JOYSAFETER_MAX_CONCURRENT_TASKS=200

# Session event 批量落库。高并发/高事件量场景建议开启，降低 DB commit 压力。
JOYSAFETER_EVENT_BATCH_ENABLED=true
JOYSAFETER_EVENT_BATCH_MAX_SIZE=200
JOYSAFETER_EVENT_BATCH_MAX_DELAY_MS=100

# Sandbox 配置。开发默认 docker；生产可切换 daytona/e2b。
JOYSAFETER_SANDBOX_PROVIDER=docker
JOYSAFETER_SANDBOX_IMAGE=joysafeter-claudecode:latest
JOYSAFETER_IMAGE_CLAUDE=joysafeter-claudecode:latest
JOYSAFETER_IMAGE_CODEX=joysafeter-codex:latest
JOYSAFETER_SANDBOX_WORKSPACE_ROOT=/tmp/joysafeter-workspaces
JOYSAFETER_SANDBOX_POOL_ENABLED=false
JOYSAFETER_SANDBOX_POOL_MIN_SIZE=2
JOYSAFETER_SANDBOX_POOL_IMAGES=["joysafeter-claudecode:latest","joysafeter-codex:latest"]
JOYSAFETER_SANDBOX_IDLE_TIMEOUT=300
JOYSAFETER_SANDBOX_STOPPED_TTL=600

# Daytona sandbox provider（JOYSAFETER_SANDBOX_PROVIDER=daytona 时必填）
JOYSAFETER_DAYTONA_API_URL=
JOYSAFETER_DAYTONA_API_KEY=
JOYSAFETER_DAYTONA_TARGET=us
JOYSAFETER_DAYTONA_SNAPSHOT=

# E2B sandbox provider（JOYSAFETER_SANDBOX_PROVIDER=e2b 时必填）
JOYSAFETER_E2B_API_URL=https://api.e2b.app
JOYSAFETER_E2B_API_KEY=
JOYSAFETER_E2B_TEMPLATE_ID=

# -----------------------------------------------------------------------------
# 文件上传存储配置
# -----------------------------------------------------------------------------
# 开发默认 local；生产可用 s3 或 oss。oss 使用 S3-compatible endpoint 配置。
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=data/files

# S3 / MinIO / S3-compatible
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_REGION=us-east-1

# Aliyun OSS S3-compatible endpoint（STORAGE_BACKEND=oss 时使用）
STORAGE_OSS_ENDPOINT=
STORAGE_OSS_BUCKET=
STORAGE_OSS_ACCESS_KEY=
STORAGE_OSS_SECRET_KEY=
STORAGE_OSS_REGION=oss-cn-hangzhou

# -----------------------------------------------------------------------------
# LangGraph 配置
# -----------------------------------------------------------------------------
# Checkpoint 配置已迁移到 CheckpointerManager，使用 POSTGRES_* 环境变量
# CHECKPOINT_ENABLED=true  # 启用 checkpoint 功能

# -----------------------------------------------------------------------------
# Langfuse 可观测性配置 (可选)
# -----------------------------------------------------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# 凭据加密配置
# -----------------------------------------------------------------------------
CREDENTIAL_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# 本地开发端口配置（可选）
# -----------------------------------------------------------------------------
# 注意：以下配置仅用于本地开发时从宿主机连接服务
# Docker Compose 端口映射配置应在 deploy/.env 中设置
#
# 如果使用 Docker Compose 部署，端口映射配置请参考 deploy/.env.example
# 在 deploy 目录下创建 .env 文件并配置端口映射及 URL 变量：
#   - BACKEND_PORT_HOST
#   - RUNNER_HEALTH_PORT_HOST
#   - WORKER_HEALTH_PORT_HOST
#   - JOYSAFETER_GRPC_PORT_HOST
#   - FRONTEND_PORT_HOST
#   - POSTGRES_PORT_HOST
#   - REDIS_PORT_HOST
#   - DEMO_MCP_SERVER_PORT
#   - SCANNER_MCP_PORT
#   - JEB_MCP_PORT
#   - MCP_PORT_3, MCP_PORT_4, MCP_PORT_5
#   - BACKEND_URL
#   - FRONTEND_URL

# -----------------------------------------------------------------------------
# 构建配置
# -----------------------------------------------------------------------------
AI_GATEWAY_BASE_URL=http://ai-api.jdcloud.com/v1
AI_GATEWAY_API_KEY=pk-xxx
AI_GATEWAY_PROVIDER=openai
AI_GATEWAY_MODEL=Kimi-K2.5

# Specific Anthropic Gateway Configuration
ANTHROPIC_BASE_URL=http://your-gateway.example.com
ANTHROPIC_AUTH_TOKEN=sk-xxx
ANTHROPIC_MODEL=your-model-name
