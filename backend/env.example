# =============================================================================
# JoySafeter Backend Environment Configuration
# =============================================================================
# This file is the complete backend configuration template.
# Copy to .env for local development or mount/provide the same variables in containers.
# Values in backend/.env are read automatically by app.joysafeter_shared.config.settings.
# =============================================================================


# -----------------------------------------------------------------------------
# ===== Application =====
# -----------------------------------------------------------------------------
# Application display name.
APP_NAME=JoySafeter

# development | staging | production
ENVIRONMENT=development

# Enable debug logs and development behavior.
DEBUG=true

# Optional build/version identifier.
GIT_COMMIT_SHA=unknown


# -----------------------------------------------------------------------------
# ===== Service Runtime =====
# -----------------------------------------------------------------------------
# Python services: api | worker. The orchestrator is the Rust binary.
JOYSAFETER_SERVICE_ROLE=api

# HTTP port used by the selected service.
BACKEND_PORT=8000

# Orchestrator HTTP health bind host.
ORCHESTRATOR_HTTP_HOST=127.0.0.1

# Worker HTTP health bind host.
WORKER_HTTP_HOST=127.0.0.1

# Enable auto reload in local development.
RELOAD=true

# Uvicorn worker process count.
WORKERS=1

# Stable runtime id for in-process run recovery; empty uses hostname.
RUN_RUNTIME_INSTANCE_ID=

# Durable run heartbeat interval.
RUN_HEARTBEAT_INTERVAL_SECONDS=15

# Durable run orphan timeout.
RUN_HEARTBEAT_TIMEOUT_SECONDS=90

# API routes are mounted at /api/v1 in code. JOYSAFETER_API_PREFIX below is kept for
# orchestrator-facing config compatibility.


# -----------------------------------------------------------------------------
# ===== HTTP / Frontend / CORS =====
# -----------------------------------------------------------------------------
# Public frontend URL used by OAuth callbacks and email links.
FRONTEND_URL=http://localhost:3000

# JSON array of allowed origins.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Legacy alias for CORS origins.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]


# -----------------------------------------------------------------------------
# ===== PostgreSQL =====
# -----------------------------------------------------------------------------
# PostgreSQL host.
POSTGRES_HOST=localhost

# PostgreSQL port.
POSTGRES_PORT=5432

# Optional local mapped port override when POSTGRES_HOST is localhost.
POSTGRES_PORT_HOST=

# PostgreSQL user.
POSTGRES_USER=postgres

# PostgreSQL password.
POSTGRES_PASSWORD=postgres

# PostgreSQL database name.
POSTGRES_DB=joysafeter

# Schema used by DB maintenance scripts.
POSTGRES_SCHEMA=public

# Optional direct DB URL for maintenance scripts; app usually builds from POSTGRES_*
DATABASE_URL=

# Log SQL queries.
DATABASE_ECHO=false

# SQLAlchemy pool size.
DATABASE_POOL_SIZE=20

# SQLAlchemy max overflow.
DATABASE_MAX_OVERFLOW=40

# Enable PgBouncer transaction-pooling compatible mode.
DATABASE_PGBOUNCER=false

# LangGraph/checkpointer min pool size.
DB_POOL_MIN_SIZE=1

# LangGraph/checkpointer max pool size.
DB_POOL_MAX_SIZE=10

# Safety switch for scripts/db/clean-db.py.
FORCE_CLEAN=false


# -----------------------------------------------------------------------------
# ===== Redis =====
# -----------------------------------------------------------------------------
# Use redis://:password@host:6379/0 or rediss:// for TLS cloud Redis.
REDIS_URL=redis://localhost:6379/0

# Redis connection pool size.
REDIS_POOL_SIZE=50


# -----------------------------------------------------------------------------
# ===== Auth / Session Cookies =====
# -----------------------------------------------------------------------------
# Required JWT secret; must be strong in production.
SECRET_KEY=change-me-generate-a-long-random-string

# JWT signing algorithm.
JWT_ALGORITHM=HS256

# Access token TTL; local dev often uses 1440.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token TTL.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Disable auth only for local development.
DISABLE_AUTH=false

# Require verified email before login.
REQUIRE_EMAIL_VERIFICATION=false

# Auth cookie name.
COOKIE_NAME=auth_token

# Cookie domain, e.g. .example.com in production.
COOKIE_DOMAIN=

# Set true behind HTTPS.
COOKIE_SECURE=false

# lax | strict | none
COOKIE_SAMESITE=lax

# Cookie max age in seconds.
COOKIE_MAX_AGE=259200


# -----------------------------------------------------------------------------
# ===== Rate Limit / Concurrency =====
# -----------------------------------------------------------------------------
# Requests per minute.
RATE_LIMIT_RPM=60

# Requests per hour.
RATE_LIMIT_RPH=1000

# Global LLM concurrency limit.
MAX_CONCURRENT_LLM_CALLS=50

# Per-user concurrency limit.
MAX_CONCURRENT_PER_USER=5


# -----------------------------------------------------------------------------
# ===== Email / SMTP =====
# -----------------------------------------------------------------------------
# SMTP host.
SMTP_HOST=

# SMTP port.
SMTP_PORT=587

# SMTP username.
SMTP_USER=

# SMTP password.
SMTP_PASSWORD=

# From email address.
FROM_EMAIL=noreply@joysafeter.ai

# From display name.
FROM_NAME=JoySafeter


# -----------------------------------------------------------------------------
# ===== OAuth / SSO =====
# -----------------------------------------------------------------------------
# Optional override for config/oauth_providers.yaml.
OAUTH_CONFIG_PATH=

# GitHub OAuth client id.
OAUTH_GITHUB_CLIENT_ID=

# GitHub OAuth client secret.
OAUTH_GITHUB_CLIENT_SECRET=

# Google OAuth client id.
OAUTH_GOOGLE_CLIENT_ID=

# Google OAuth client secret.
OAUTH_GOOGLE_CLIENT_SECRET=

# Microsoft OAuth client id.
OAUTH_MICROSOFT_CLIENT_ID=

# Microsoft OAuth client secret.
OAUTH_MICROSOFT_CLIENT_SECRET=

# GitLab OAuth client id.
OAUTH_GITLAB_CLIENT_ID=

# GitLab OAuth client secret.
OAUTH_GITLAB_CLIENT_SECRET=

# Keycloak/OIDC client id.
OAUTH_KEYCLOAK_CLIENT_ID=

# Keycloak/OIDC client secret.
OAUTH_KEYCLOAK_CLIENT_SECRET=

# Authentik/OIDC client id.
OAUTH_AUTHENTIK_CLIENT_ID=

# Authentik/OIDC client secret.
OAUTH_AUTHENTIK_CLIENT_SECRET=

# Local mock OAuth client id.
OAUTH_LOCAL_CLIENT_ID=local-client

# Local mock OAuth client secret.
OAUTH_LOCAL_CLIENT_SECRET=local-secret

# JD SSO client id.
JD_CLIENT_ID=

# JD SSO client secret.
JD_CLIENT_SECRET=

# JD SSO authorization URL.
JD_AUTHORIZE_URL=

# JD SSO token URL.
JD_TOKEN_URL=

# JD SSO userinfo URL.
JD_USERINFO_URL=


# -----------------------------------------------------------------------------
# ===== JoySafeter Orchestrator Core =====
# -----------------------------------------------------------------------------
# Enable JoySafeter orchestrator features.
JOYSAFETER_ENABLED=true

# Managed API prefix.
JOYSAFETER_API_PREFIX=/api/v1

# Stable orchestrator instance id.
JOYSAFETER_INSTANCE_ID=orchestrator-001

# Redis key prefix.
JOYSAFETER_REDIS_QUEUE_PREFIX=joysafeter

# Max active tasks.
JOYSAFETER_MAX_CONCURRENT_TASKS=200

# Max scheduling tasks.
JOYSAFETER_MAX_SCHEDULING_TASKS=50

# Default task timeout seconds.
JOYSAFETER_TASK_DEFAULT_TIMEOUT=7200

# Default task retries.
JOYSAFETER_TASK_DEFAULT_MAX_RETRIES=2

# Retry backoff base ms.
JOYSAFETER_TASK_RETRY_BASE_MS=2000

# Retry backoff max ms.
JOYSAFETER_TASK_RETRY_MAX_MS=30000


# -----------------------------------------------------------------------------
# ===== JoySafeter Events =====
# -----------------------------------------------------------------------------
# Enable in-process event batching.
JOYSAFETER_EVENT_BATCH_ENABLED=true

# Max events per batch.
JOYSAFETER_EVENT_BATCH_MAX_SIZE=200

# Max batch delay ms.
JOYSAFETER_EVENT_BATCH_MAX_DELAY_MS=100

# Enable Redis Stream event pipeline.
JOYSAFETER_EVENT_STREAM_ENABLED=true

# Redis stream key.
JOYSAFETER_EVENT_STREAM_KEY=joysafeter:orchestrator:events

# Redis consumer group.
JOYSAFETER_EVENT_STREAM_GROUP=joysafeter-orchestrator-event-workers

# Approx max Redis stream length.
JOYSAFETER_EVENT_STREAM_MAX_LEN=100000

# Worker stream read batch size.
JOYSAFETER_EVENT_STREAM_BATCH_SIZE=100

# Worker stream block ms.
JOYSAFETER_EVENT_STREAM_BLOCK_MS=1000

# Fallback direct DB write if stream publish fails.
JOYSAFETER_EVENT_STREAM_FALLBACK_TO_DB=true

# Pending stream idle claim threshold.
JOYSAFETER_EVENT_STREAM_PENDING_IDLE_MS=60000

# Max failed deliveries before a stream event is copied to the dead-letter stream.
JOYSAFETER_EVENT_STREAM_MAX_DELIVERIES=5

# Dead-letter stream suffix appended to JOYSAFETER_EVENT_STREAM_KEY.
JOYSAFETER_EVENT_STREAM_DEAD_LETTER_SUFFIX=:dead

# Producer high-water mark; 0 derives 90% of JOYSAFETER_EVENT_STREAM_MAX_LEN.
JOYSAFETER_EVENT_STREAM_HIGH_WATER_MARK=0


# -----------------------------------------------------------------------------
# ===== Sandbox / Runner Images =====
# -----------------------------------------------------------------------------
# docker | daytona | e2b
JOYSAFETER_SANDBOX_PROVIDER=docker
# shared_container | remote_workspace | isolated_vm
# The Rust orchestrator fails fast if the selected provider is weaker than this.
JOYSAFETER_SANDBOX_MIN_ISOLATION_CLASS=shared_container

# Default sandbox image.
JOYSAFETER_SANDBOX_IMAGE=joysafeter-claudecode:latest

# Claude Code engine image.
JOYSAFETER_IMAGE_CLAUDE=joysafeter-claudecode:latest

# Codex engine image.
JOYSAFETER_IMAGE_CODEX=joysafeter-codex:latest

# Native/mock-compatible engine image. Empty falls back to the Claude image or default sandbox image.
JOYSAFETER_IMAGE_NATIVE=joysafeter-native:latest

# Host workspace root for docker sandbox provider.
JOYSAFETER_SANDBOX_WORKSPACE_ROOT=/tmp/joysafeter-workspaces

# -----------------------------------------------------------------------------
# Sandbox lifecycle & reaping
# -----------------------------------------------------------------------------
# Idle sweeper has three independent reap criteria, fastest first:
#   1) idle_since:      RunnerIdle from the runner (precise "all done" signal;
#                       cc's heldBackResult covers background sub-agents, codex
#                       multi-agent aggregates child threads in the runtime
#                       adapter). Normal sessions exit through this path.
#   2) disconnected_at: gRPC bridge has been gone past the grace window.
#                       Fallback for runner crashes / network partitions.
#   3) created_at:      sandbox lifetime past the hard cap. Last-resort zombie
#                       defence when criteria 1 and 2 both fail to fire.

# idle_since timeout — how long a sandbox stays in "idle" before being reaped.
# This is what end users perceive as "sandbox shuts down after N seconds idle".
JOYSAFETER_SANDBOX_IDLE_TIMEOUT=300

# How long a "stopped" sandbox is kept around before the container is destroyed.
JOYSAFETER_SANDBOX_STOPPED_TTL=600

# Bridge-disconnect grace: how long after the gRPC stream drops before the
# fallback sweeper concludes the runner is dead and reaps the sandbox.
#   - Too short: a brief network blip kills sandboxes the runner could have
#                cleanly reconnected to.
#   - Too long:  a really dead runner ties up resources longer than necessary.
JOYSAFETER_SANDBOX_BRIDGE_DISCONNECT_GRACE=90

# Hard timeout: absolute wall-clock cap on any non-terminal sandbox lifetime.
# Sandboxes in any of creating / provisioning / running / idle are reaped once
# created_at is older than this many seconds. Defence in depth — only fires
# when both idle_since and disconnected_at paths have failed.
#   - 21600 (6h, default): plenty for ~all sessions; a single task rarely runs
#                          this long unless something is wrong.
#   - 43200 (12h): occasional long-running migrations / batch refactors.
#   - 86400 (24h): regular very-long batch jobs.
#   - 0:           disabled — rely only on idle_since + disconnected_at. Not
#                  recommended for production (removes the last safety net).
# Tasks pending on a hard-timeout'd sandbox are auto-requeued onto a fresh
# sandbox; only the currently-executing task is lost.
JOYSAFETER_SANDBOX_HARD_TIMEOUT=21600

# Failure threshold before sandbox replacement.
JOYSAFETER_SANDBOX_FAILURE_THRESHOLD=3

# Optional Docker CPU limit.
# JOYSAFETER_SANDBOX_CPU=

# Optional Docker memory limit MB.
# JOYSAFETER_SANDBOX_MEMORY_MB=

# Optional disk limit MB where supported.
# JOYSAFETER_SANDBOX_DISK_MB=

# -----------------------------------------------------------------------------
# Sandbox container hardening (P0.1 — Anthropic security guide baseline)
# -----------------------------------------------------------------------------
# Applied to every sandbox container we create. Coding agents (cc/codex/native)
# run as the non-root `agent` user (uid 1000) and don't need any Linux
# capabilities, so these secure defaults have ZERO operational impact while
# closing the prompt-injection → privilege-escalation chain. Only flip any of
# them off for short-term targeted debugging.

# Drop the default-14 Linux capabilities Docker grants (--cap-drop ALL).
# Even if an attacker pivots to root inside the sandbox, root has no
# capabilities left — can't chown, mount, ptrace, raw-socket, etc.
# Emergency rollback: false  (lets the default 14 caps come back)
JOYSAFETER_SANDBOX_DROP_ALL_CAPS=true

# Forbid setuid / file-cap based privilege escalation
# (--security-opt no-new-privileges). `sudo`, `mount`, `ping` etc. fail
# inside the sandbox. Coding agents don't need any of these.
# Emergency rollback: false  (allows setuid-based escalation)
JOYSAFETER_SANDBOX_NO_NEW_PRIVILEGES=true

# Cap on PIDs inside the sandbox. Prevents fork bombs / runaway test loops.
# 256 is generous for a coding agent (compilation can fan out, but rarely
# past a few dozen). Set to 0 to disable.
# Emergency rollback: 0  (no PID limit)
JOYSAFETER_SANDBOX_PIDS_LIMIT=256

# Force-run the sandbox as this uid:gid even if the image's USER directive
# was overridden / removed. Defense in depth — our base images already use
# `agent` (uid 1000), but this guarantees it. Empty = use image default.
# Emergency rollback: leave empty  (falls back to the image's USER directive)
JOYSAFETER_SANDBOX_RUN_AS_USER=1000:1000


# Codex's *own* filesystem sandbox tier (separate from JoySafeter's Docker
# isolation). MUST stay "danger-full-access" inside our managed sandboxes:
# Docker + CapDrop=ALL + no-new-privileges already isolate us, but Codex
# tries to layer its own Landlock/seccomp sandbox on top. Cap-drop blocks
# the syscalls it needs, so it fork-retries forever, exhausts the per-UID
# nproc cap and makes every later fork (incl. ``bash`` / ``ls``) fail with
# EAGAIN. Only tighten if you've disabled the host cap-drop policy.
JOYSAFETER_CODEX_SANDBOX_MODE=danger-full-access


# Register mock runtime adapter for development.
JOYSAFETER_MOCK_ADAPTER=false


# -----------------------------------------------------------------------------
# ===== Sandbox Pool =====
# -----------------------------------------------------------------------------
# Prewarm sandbox pool.
JOYSAFETER_SANDBOX_POOL_ENABLED=false

# Minimum pooled sandboxes.
JOYSAFETER_SANDBOX_POOL_MIN_SIZE=2

# Max pooled sandbox age seconds.
JOYSAFETER_SANDBOX_POOL_MAX_AGE=1800

# JSON array of pool images.
JOYSAFETER_SANDBOX_POOL_IMAGES=["joysafeter-claudecode:latest","joysafeter-codex:latest"]


# -----------------------------------------------------------------------------
# ===== Daytona Provider =====
# -----------------------------------------------------------------------------
# Daytona API URL.
JOYSAFETER_DAYTONA_API_URL=

# Daytona API key.
JOYSAFETER_DAYTONA_API_KEY=

# Daytona target/region.
JOYSAFETER_DAYTONA_TARGET=

# Daytona snapshot id/name.
JOYSAFETER_DAYTONA_SNAPSHOT=


# -----------------------------------------------------------------------------
# ===== E2B Provider =====
# -----------------------------------------------------------------------------
# E2B API URL.
JOYSAFETER_E2B_API_URL=https://api.e2b.app

# E2B API key.
JOYSAFETER_E2B_API_KEY=

# E2B template id.
JOYSAFETER_E2B_TEMPLATE_ID=


# -----------------------------------------------------------------------------
# ===== gRPC / Orchestrator =====
# -----------------------------------------------------------------------------
# gRPC bind host.
JOYSAFETER_GRPC_HOST=0.0.0.0

# gRPC bind port.
JOYSAFETER_GRPC_PORT=9090

# URL sandbox containers use to connect back.
JOYSAFETER_GRPC_PUBLIC_URL=http://host.docker.internal:9090

# Orchestrator heartbeat interval.
JOYSAFETER_HEARTBEAT_INTERVAL=15

# Orchestrator heartbeat TTL.
JOYSAFETER_HEARTBEAT_TTL=30

# Running-task lease TTL before another orchestrator can reclaim an abandoned task.
JOYSAFETER_TASK_LEASE_TTL_SEC=45

# How often the owning orchestrator renews running-task leases.
JOYSAFETER_TASK_LEASE_RENEW_INTERVAL_SEC=10


# -----------------------------------------------------------------------------
# ===== Network Isolation / Envoy =====
# -----------------------------------------------------------------------------
# Enable Envoy network isolation sidecar.
JOYSAFETER_ENVOY_ENABLED=false

# Envoy image.
JOYSAFETER_ENVOY_IMAGE=envoyproxy/envoy:v1.37.1

# Docker volume for Envoy socket.
JOYSAFETER_ENVOY_SOCKET_VOLUME=joysafeter-sockets

# Generated Envoy config dir.
JOYSAFETER_ENVOY_CONFIG_DIR=/tmp/joysafeter-envoy-config

# Docker network for Envoy.
JOYSAFETER_ENVOY_NETWORK=joysafeter-net

# Envoy upstream gRPC host.
JOYSAFETER_ENVOY_GRPC_HOST=host.docker.internal

# Envoy upstream gRPC port.
JOYSAFETER_ENVOY_GRPC_PORT=9090

# Envoy container name.
JOYSAFETER_ENVOY_CONTAINER_NAME=joysafeter-envoy

# Hosts that may receive Envoy-injected LLM credentials. Keep this explicit:
# add custom Anthropic/OpenAI-compatible gateways here before using them.
JOYSAFETER_LLM_EGRESS_ALLOWED_HOSTS=api.anthropic.com,api.openai.com,generativelanguage.googleapis.com,*.openai.azure.com,*.jdcloud.com

# Block private IP targets in SSRF guard.
JOYSAFETER_SSRF_BLOCK_PRIVATE=false

# Require HTTPS in SSRF guard.
JOYSAFETER_SSRF_HTTPS_ONLY=false


# -----------------------------------------------------------------------------
# ===== Image Builder =====
# -----------------------------------------------------------------------------
# Enable custom sandbox image builder.
JOYSAFETER_IMAGE_BUILDER_ENABLED=false

# Base image for custom builds.
JOYSAFETER_IMAGE_BUILDER_BASE=joysafeter-claudecode:latest


# -----------------------------------------------------------------------------
# ===== Storage =====
# -----------------------------------------------------------------------------
# local | s3 | oss
STORAGE_BACKEND=local

# Local file storage path.
STORAGE_LOCAL_PATH=data/files

# User file upload limit in bytes. Default is 50MB; 200MB = 209715200.
JOYSAFETER_MAX_UPLOAD_FILE_BYTES=52428800

# S3/MinIO endpoint.
STORAGE_S3_ENDPOINT=

# S3 bucket.
STORAGE_S3_BUCKET=

# S3 access key.
STORAGE_S3_ACCESS_KEY=

# S3 secret key.
STORAGE_S3_SECRET_KEY=

# S3 region.
STORAGE_S3_REGION=us-east-1

# Aliyun OSS S3-compatible endpoint.
STORAGE_OSS_ENDPOINT=

# OSS bucket.
STORAGE_OSS_BUCKET=

# OSS access key.
STORAGE_OSS_ACCESS_KEY=

# OSS secret key.
STORAGE_OSS_SECRET_KEY=

# OSS region.
STORAGE_OSS_REGION=oss-cn-hangzhou


# -----------------------------------------------------------------------------
# ===== Encryption =====
# -----------------------------------------------------------------------------
# Credential encryption key; required for stable production decryption.
CREDENTIAL_ENCRYPTION_KEY=

# Vault encryption key; required for stable production vault and managed secret decryption.
JOYSAFETER_VAULT_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# ===== Observability =====
# -----------------------------------------------------------------------------
# Enable Langfuse tracing.
LANGFUSE_ENABLED=false

# Langfuse public key.
LANGFUSE_PUBLIC_KEY=

# Langfuse secret key.
LANGFUSE_SECRET_KEY=

# Langfuse host.
LANGFUSE_HOST=https://cloud.langfuse.com

# Enable OpenTelemetry export.
OTEL_ENABLED=false

# OTel service name.
OTEL_SERVICE_NAME=joysafeter-backend

# OTLP endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=

# OTLP headers.
OTEL_EXPORTER_OTLP_HEADERS=

# grpc | http/protobuf
OTEL_EXPORTER_OTLP_PROTOCOL=grpc


# -----------------------------------------------------------------------------
# ===== Artifact / Workspace =====
# -----------------------------------------------------------------------------
# Root directory for session files and sandbox data.
WORKSPACE_ROOT=workspace

# Agent artifact root; empty uses default.
AGENT_ARTIFACTS_ROOT=

# Legacy DeepAgents artifact root retained for compatibility; empty uses default.
DEEPAGENTS_ARTIFACTS_DIR=


# -----------------------------------------------------------------------------
# ===== Skill Security Scanning =====
# -----------------------------------------------------------------------------
# Enable SkillSpector gate on skill create/update/import/file changes.
SKILL_SECURITY_SCAN_ENABLED=false
SKILL_SECURITY_SCANNER_URL=http://skillspector:8010
SKILL_SECURITY_TIMEOUT_SECONDS=30
# Total scan-input bytes above which scan_for_write defers to a background task.
SKILL_SECURITY_ASYNC_THRESHOLD_BYTES=102400
SKILL_SECURITY_FAIL_CLOSED=true
SKILL_SECURITY_NO_LLM=true
SKILL_SECURITY_BLOCK_RECOMMENDATIONS=DO_NOT_INSTALL

# Skill ZIP import limits.
SKILL_IMPORT_MAX_ZIP_BYTES=20971520
SKILL_IMPORT_MAX_FILES=200
SKILL_IMPORT_MAX_FILE_BYTES=2097152
SKILL_IMPORT_MAX_TOTAL_FILE_BYTES=10485760


# -----------------------------------------------------------------------------
# ===== Python Package Index =====
# -----------------------------------------------------------------------------
# uv/pip package index.
UV_INDEX_URL=https://pypi.org/simple

# Alias used by builds and uv config.
PIP_INDEX_URL=https://pypi.org/simple


# -----------------------------------------------------------------------------
# ===== Model / Agent Secret Defaults =====
# -----------------------------------------------------------------------------
# Anthropic API key; runtime secrets usually preferred.
ANTHROPIC_API_KEY=

# Anthropic auth token / gateway key.
ANTHROPIC_AUTH_TOKEN=

# Anthropic-compatible base URL.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Default Anthropic model.
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI-compatible gateway base URL.
AI_GATEWAY_BASE_URL=

# Gateway API key.
AI_GATEWAY_API_KEY=

# Gateway provider type.
AI_GATEWAY_PROVIDER=openai

# Gateway default model.
AI_GATEWAY_MODEL=


# -----------------------------------------------------------------------------
# ===== Tools =====
# -----------------------------------------------------------------------------
# Enable tavily_search builtin tool.
TAVILY_API_KEY=

# Enable Runloop sandbox tools.
RUNLOOP_API_KEY=


# -----------------------------------------------------------------------------
# ===== Docker Client =====
# -----------------------------------------------------------------------------
# Optional Docker daemon URL/context host.
DOCKER_HOST=

# Optional Docker config directory.
DOCKER_CONFIG=
