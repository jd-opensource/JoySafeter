# =============================================================================
# JoySafeter Backend Environment Configuration
# =============================================================================
# This file is the complete backend configuration template.
# Copy to .env for local development or mount/provide the same variables in containers.
# Values in backend/.env are read automatically by app.joysafeter_shared.config.settings.
# =============================================================================


# -----------------------------------------------------------------------------
# ===== Application =====
# -----------------------------------------------------------------------------
# Application display name.
APP_NAME=JoySafeter

# development | staging | production
ENVIRONMENT=development

# Enable debug logs and development behavior.
DEBUG=true

# Optional build/version identifier.
GIT_COMMIT_SHA=unknown


# -----------------------------------------------------------------------------
# ===== Service Runtime =====
# -----------------------------------------------------------------------------
# all | api | orchestrator | worker
JOYSAFETER_SERVICE_ROLE=all

# HTTP port used by the selected service.
BACKEND_PORT=8000

# Orchestrator HTTP health bind host.
ORCHESTRATOR_HTTP_HOST=127.0.0.1

# Worker HTTP health bind host.
WORKER_HTTP_HOST=127.0.0.1

# Enable auto reload in local development.
RELOAD=true

# Uvicorn worker process count.
WORKERS=1

# Stable runtime id for in-process run recovery; empty uses hostname.
RUN_RUNTIME_INSTANCE_ID=

# Durable run heartbeat interval.
RUN_HEARTBEAT_INTERVAL_SECONDS=15

# Durable run orphan timeout.
RUN_HEARTBEAT_TIMEOUT_SECONDS=90

# Legacy v1 API prefix.
API_V1_PREFIX=/api/v1


# -----------------------------------------------------------------------------
# ===== HTTP / Frontend / CORS =====
# -----------------------------------------------------------------------------
# Public frontend URL used by OAuth callbacks and email links.
FRONTEND_URL=http://localhost:3000

# JSON array of allowed origins.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Legacy alias for CORS origins.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]


# -----------------------------------------------------------------------------
# ===== PostgreSQL =====
# -----------------------------------------------------------------------------
# PostgreSQL host.
POSTGRES_HOST=localhost

# PostgreSQL port.
POSTGRES_PORT=5432

# Optional local mapped port override when POSTGRES_HOST is localhost.
POSTGRES_PORT_HOST=

# PostgreSQL user.
POSTGRES_USER=postgres

# PostgreSQL password.
POSTGRES_PASSWORD=postgres

# PostgreSQL database name.
POSTGRES_DB=joysafeter

# Schema used by DB maintenance scripts.
POSTGRES_SCHEMA=public

# Optional direct DB URL for maintenance scripts; app usually builds from POSTGRES_*
DATABASE_URL=

# Log SQL queries.
DATABASE_ECHO=false

# SQLAlchemy pool size.
DATABASE_POOL_SIZE=20

# SQLAlchemy max overflow.
DATABASE_MAX_OVERFLOW=40

# Enable PgBouncer transaction-pooling compatible mode.
DATABASE_PGBOUNCER=false

# LangGraph/checkpointer min pool size.
DB_POOL_MIN_SIZE=1

# LangGraph/checkpointer max pool size.
DB_POOL_MAX_SIZE=10

# Safety switch for scripts/db/clean-db.py.
FORCE_CLEAN=false


# -----------------------------------------------------------------------------
# ===== Redis =====
# -----------------------------------------------------------------------------
# Use redis://:password@host:6379/0 or rediss:// for TLS cloud Redis.
REDIS_URL=redis://localhost:6379/0

# Redis connection pool size.
REDIS_POOL_SIZE=50


# -----------------------------------------------------------------------------
# ===== Auth / Session Cookies =====
# -----------------------------------------------------------------------------
# Required JWT secret; must be strong in production.
SECRET_KEY=change-me-generate-a-long-random-string

# JWT signing algorithm.
JWT_ALGORITHM=HS256

# Access token TTL; local dev often uses 1440.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token TTL.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Disable auth only for local development.
DISABLE_AUTH=false

# Require verified email before login.
REQUIRE_EMAIL_VERIFICATION=false

# Auth cookie name.
COOKIE_NAME=auth_token

# Cookie domain, e.g. .example.com in production.
COOKIE_DOMAIN=

# Set true behind HTTPS.
COOKIE_SECURE=false

# lax | strict | none
COOKIE_SAMESITE=lax

# Cookie max age in seconds.
COOKIE_MAX_AGE=259200


# -----------------------------------------------------------------------------
# ===== Rate Limit / Concurrency =====
# -----------------------------------------------------------------------------
# Requests per minute.
RATE_LIMIT_RPM=60

# Requests per hour.
RATE_LIMIT_RPH=1000

# Global LLM concurrency limit.
MAX_CONCURRENT_LLM_CALLS=50

# Per-user concurrency limit.
MAX_CONCURRENT_PER_USER=5


# -----------------------------------------------------------------------------
# ===== Email / SMTP =====
# -----------------------------------------------------------------------------
# SMTP host.
SMTP_HOST=

# SMTP port.
SMTP_PORT=587

# SMTP username.
SMTP_USER=

# SMTP password.
SMTP_PASSWORD=

# From email address.
SMTP_FROM=

# Enable SMTP TLS.
SMTP_TLS=true


# -----------------------------------------------------------------------------
# ===== OAuth / SSO =====
# -----------------------------------------------------------------------------
# Optional override for config/oauth_providers.yaml.
OAUTH_CONFIG_PATH=

# GitHub OAuth client id.
OAUTH_GITHUB_CLIENT_ID=

# GitHub OAuth client secret.
OAUTH_GITHUB_CLIENT_SECRET=

# Google OAuth client id.
OAUTH_GOOGLE_CLIENT_ID=

# Google OAuth client secret.
OAUTH_GOOGLE_CLIENT_SECRET=

# Microsoft OAuth client id.
OAUTH_MICROSOFT_CLIENT_ID=

# Microsoft OAuth client secret.
OAUTH_MICROSOFT_CLIENT_SECRET=

# GitLab OAuth client id.
OAUTH_GITLAB_CLIENT_ID=

# GitLab OAuth client secret.
OAUTH_GITLAB_CLIENT_SECRET=

# Keycloak/OIDC client id.
OAUTH_KEYCLOAK_CLIENT_ID=

# Keycloak/OIDC client secret.
OAUTH_KEYCLOAK_CLIENT_SECRET=

# Authentik/OIDC client id.
OAUTH_AUTHENTIK_CLIENT_ID=

# Authentik/OIDC client secret.
OAUTH_AUTHENTIK_CLIENT_SECRET=

# Local mock OAuth client id.
OAUTH_LOCAL_CLIENT_ID=local-client

# Local mock OAuth client secret.
OAUTH_LOCAL_CLIENT_SECRET=local-secret

# JD SSO client id.
JD_CLIENT_ID=

# JD SSO client secret.
JD_CLIENT_SECRET=

# JD SSO authorization URL.
JD_AUTHORIZE_URL=

# JD SSO token URL.
JD_TOKEN_URL=

# JD SSO userinfo URL.
JD_USERINFO_URL=


# -----------------------------------------------------------------------------
# ===== JoySafeter Orchestrator Core =====
# -----------------------------------------------------------------------------
# Enable JoySafeter orchestrator features.
JOYSAFETER_ENABLED=true

# Managed API prefix.
JOYSAFETER_API_PREFIX=/api/v2

# Stable orchestrator instance id.
JOYSAFETER_INSTANCE_ID=orchestrator-001

# Redis key prefix.
JOYSAFETER_REDIS_QUEUE_PREFIX=joysafeter

# Max active tasks.
JOYSAFETER_MAX_CONCURRENT_TASKS=200

# Max scheduling tasks.
JOYSAFETER_MAX_SCHEDULING_TASKS=50

# Default task timeout seconds.
JOYSAFETER_TASK_DEFAULT_TIMEOUT=7200

# Default task retries.
JOYSAFETER_TASK_DEFAULT_MAX_RETRIES=2

# Retry backoff base ms.
JOYSAFETER_TASK_RETRY_BASE_MS=2000

# Retry backoff max ms.
JOYSAFETER_TASK_RETRY_MAX_MS=30000


# -----------------------------------------------------------------------------
# ===== JoySafeter Events =====
# -----------------------------------------------------------------------------
# Enable in-process event batching.
JOYSAFETER_EVENT_BATCH_ENABLED=true

# Max events per batch.
JOYSAFETER_EVENT_BATCH_MAX_SIZE=200

# Max batch delay ms.
JOYSAFETER_EVENT_BATCH_MAX_DELAY_MS=100

# Enable Redis Stream event pipeline.
JOYSAFETER_EVENT_STREAM_ENABLED=true

# Redis stream key.
JOYSAFETER_EVENT_STREAM_KEY=joysafeter:orchestrator:events

# Redis consumer group.
JOYSAFETER_EVENT_STREAM_GROUP=joysafeter-orchestrator-event-workers

# Approx max Redis stream length.
JOYSAFETER_EVENT_STREAM_MAX_LEN=100000

# Worker stream read batch size.
JOYSAFETER_EVENT_STREAM_BATCH_SIZE=100

# Worker stream block ms.
JOYSAFETER_EVENT_STREAM_BLOCK_MS=1000

# Fallback direct DB write if stream publish fails.
JOYSAFETER_EVENT_STREAM_FALLBACK_TO_DB=true

# Pending stream idle claim threshold.
JOYSAFETER_EVENT_STREAM_PENDING_IDLE_MS=60000


# -----------------------------------------------------------------------------
# ===== Sandbox / Runner Images =====
# -----------------------------------------------------------------------------
# docker | daytona | e2b
JOYSAFETER_SANDBOX_PROVIDER=docker

# Default sandbox image.
JOYSAFETER_SANDBOX_IMAGE=joysafeter-claudecode:latest

# Claude Code engine image.
JOYSAFETER_IMAGE_CLAUDE=joysafeter-claudecode:latest

# Codex engine image.
JOYSAFETER_IMAGE_CODEX=joysafeter-codex:latest

# Host workspace root for docker sandbox provider.
JOYSAFETER_SANDBOX_WORKSPACE_ROOT=/tmp/joysafeter-workspaces

# Idle sandbox timeout seconds.
JOYSAFETER_SANDBOX_IDLE_TIMEOUT=300

# Stopped sandbox TTL seconds.
JOYSAFETER_SANDBOX_STOPPED_TTL=600

# Failure threshold before sandbox replacement.
JOYSAFETER_SANDBOX_FAILURE_THRESHOLD=3

# Optional Docker CPU limit.
# JOYSAFETER_SANDBOX_CPU=

# Optional Docker memory limit MB.
# JOYSAFETER_SANDBOX_MEMORY_MB=

# Optional disk limit MB where supported.
# JOYSAFETER_SANDBOX_DISK_MB=

# Register mock runtime adapter for development.
JOYSAFETER_MOCK_ADAPTER=false


# -----------------------------------------------------------------------------
# ===== Sandbox Pool =====
# -----------------------------------------------------------------------------
# Prewarm sandbox pool.
JOYSAFETER_SANDBOX_POOL_ENABLED=false

# Minimum pooled sandboxes.
JOYSAFETER_SANDBOX_POOL_MIN_SIZE=2

# Max pooled sandbox age seconds.
JOYSAFETER_SANDBOX_POOL_MAX_AGE=1800

# JSON array of pool images.
JOYSAFETER_SANDBOX_POOL_IMAGES=["joysafeter-claudecode:latest","joysafeter-codex:latest"]


# -----------------------------------------------------------------------------
# ===== Daytona Provider =====
# -----------------------------------------------------------------------------
# Daytona API URL.
JOYSAFETER_DAYTONA_API_URL=

# Daytona API key.
JOYSAFETER_DAYTONA_API_KEY=

# Daytona target/region.
JOYSAFETER_DAYTONA_TARGET=

# Daytona snapshot id/name.
JOYSAFETER_DAYTONA_SNAPSHOT=


# -----------------------------------------------------------------------------
# ===== E2B Provider =====
# -----------------------------------------------------------------------------
# E2B API URL.
JOYSAFETER_E2B_API_URL=https://api.e2b.app

# E2B API key.
JOYSAFETER_E2B_API_KEY=

# E2B template id.
JOYSAFETER_E2B_TEMPLATE_ID=


# -----------------------------------------------------------------------------
# ===== gRPC / Orchestrator =====
# -----------------------------------------------------------------------------
# gRPC bind host.
JOYSAFETER_GRPC_HOST=0.0.0.0

# gRPC bind port.
JOYSAFETER_GRPC_PORT=9090

# URL sandbox containers use to connect back.
JOYSAFETER_GRPC_PUBLIC_URL=http://host.docker.internal:9090

# Orchestrator heartbeat interval.
JOYSAFETER_HEARTBEAT_INTERVAL=15

# Orchestrator heartbeat TTL.
JOYSAFETER_HEARTBEAT_TTL=30


# -----------------------------------------------------------------------------
# ===== Network Isolation / Envoy =====
# -----------------------------------------------------------------------------
# Enable Envoy network isolation sidecar.
JOYSAFETER_ENVOY_ENABLED=false

# Envoy image.
JOYSAFETER_ENVOY_IMAGE=envoyproxy/envoy:v1.31-latest

# Docker volume for Envoy socket.
JOYSAFETER_ENVOY_SOCKET_VOLUME=joysafeter-sockets

# Generated Envoy config dir.
JOYSAFETER_ENVOY_CONFIG_DIR=/tmp/joysafeter-envoy-config

# Docker network for Envoy.
JOYSAFETER_ENVOY_NETWORK=joysafeter-net

# Envoy upstream gRPC host.
JOYSAFETER_ENVOY_GRPC_HOST=host.docker.internal

# Envoy upstream gRPC port.
JOYSAFETER_ENVOY_GRPC_PORT=9090

# Envoy container name.
JOYSAFETER_ENVOY_CONTAINER_NAME=joysafeter-envoy

# Block private IP targets in SSRF guard.
JOYSAFETER_SSRF_BLOCK_PRIVATE=false

# Require HTTPS in SSRF guard.
JOYSAFETER_SSRF_HTTPS_ONLY=false


# -----------------------------------------------------------------------------
# ===== Image Builder =====
# -----------------------------------------------------------------------------
# Enable custom sandbox image builder.
JOYSAFETER_IMAGE_BUILDER_ENABLED=false

# Base image for custom builds.
JOYSAFETER_IMAGE_BUILDER_BASE=joysafeter-claudecode:latest


# -----------------------------------------------------------------------------
# ===== Storage =====
# -----------------------------------------------------------------------------
# local | s3 | oss
STORAGE_BACKEND=local

# Local file storage path.
STORAGE_LOCAL_PATH=data/files

# S3/MinIO endpoint.
STORAGE_S3_ENDPOINT=

# S3 bucket.
STORAGE_S3_BUCKET=

# S3 access key.
STORAGE_S3_ACCESS_KEY=

# S3 secret key.
STORAGE_S3_SECRET_KEY=

# S3 region.
STORAGE_S3_REGION=us-east-1

# Aliyun OSS S3-compatible endpoint.
STORAGE_OSS_ENDPOINT=

# OSS bucket.
STORAGE_OSS_BUCKET=

# OSS access key.
STORAGE_OSS_ACCESS_KEY=

# OSS secret key.
STORAGE_OSS_SECRET_KEY=

# OSS region.
STORAGE_OSS_REGION=oss-cn-hangzhou


# -----------------------------------------------------------------------------
# ===== Encryption =====
# -----------------------------------------------------------------------------
# Credential encryption key; required for stable production decryption.
CREDENTIAL_ENCRYPTION_KEY=

# Vault encryption key; required for stable production vault and managed secret decryption.
JOYSAFETER_VAULT_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# ===== Observability =====
# -----------------------------------------------------------------------------
# Enable Langfuse tracing.
LANGFUSE_ENABLED=false

# Langfuse public key.
LANGFUSE_PUBLIC_KEY=

# Langfuse secret key.
LANGFUSE_SECRET_KEY=

# Langfuse host.
LANGFUSE_HOST=https://cloud.langfuse.com

# Enable OpenTelemetry export.
OTEL_ENABLED=false

# OTel service name.
OTEL_SERVICE_NAME=joysafeter-backend

# OTLP endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=

# OTLP headers.
OTEL_EXPORTER_OTLP_HEADERS=

# grpc | http/protobuf
OTEL_EXPORTER_OTLP_PROTOCOL=grpc


# -----------------------------------------------------------------------------
# ===== Artifact / Workspace =====
# -----------------------------------------------------------------------------
# Root directory for session files and sandbox data.
WORKSPACE_ROOT=workspace

# Agent artifact root; empty uses default.
AGENT_ARTIFACTS_ROOT=

# DeepAgents artifact root; empty uses default.
DEEPAGENTS_ARTIFACTS_DIR=


# -----------------------------------------------------------------------------
# ===== Skill Security Scanning =====
# -----------------------------------------------------------------------------
# Enable SkillSpector gate on skill create/update/import/file changes.
SKILL_SECURITY_SCAN_ENABLED=false
SKILL_SECURITY_SCANNER_URL=http://skillspector:8010
SKILL_SECURITY_TIMEOUT_SECONDS=30
SKILL_SECURITY_FAIL_CLOSED=true
SKILL_SECURITY_NO_LLM=true
SKILL_SECURITY_BLOCK_RECOMMENDATIONS=DO_NOT_INSTALL


# -----------------------------------------------------------------------------
# ===== Python Package Index =====
# -----------------------------------------------------------------------------
# uv/pip package index.
UV_INDEX_URL=https://pypi.org/simple

# Alias used by builds and uv config.
PIP_INDEX_URL=https://pypi.org/simple


# -----------------------------------------------------------------------------
# ===== Model / Agent Secret Defaults =====
# -----------------------------------------------------------------------------
# Anthropic API key; runtime secrets usually preferred.
ANTHROPIC_API_KEY=

# Anthropic auth token / gateway key.
ANTHROPIC_AUTH_TOKEN=

# Anthropic-compatible base URL.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Default Anthropic model.
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI-compatible gateway base URL.
AI_GATEWAY_BASE_URL=

# Gateway API key.
AI_GATEWAY_API_KEY=

# Gateway provider type.
AI_GATEWAY_PROVIDER=openai

# Gateway default model.
AI_GATEWAY_MODEL=


# -----------------------------------------------------------------------------
# ===== Tools =====
# -----------------------------------------------------------------------------
# Enable tavily_search builtin tool.
TAVILY_API_KEY=

# Enable Runloop sandbox tools.
RUNLOOP_API_KEY=


# -----------------------------------------------------------------------------
# ===== Docker Client =====
# -----------------------------------------------------------------------------
# Optional Docker daemon URL/context host.
DOCKER_HOST=

# Optional Docker config directory.
DOCKER_CONFIG=
