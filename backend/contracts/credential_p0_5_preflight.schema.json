{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Credential P0.5 preflight report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credential_type_counts",
    "cross_project_references",
    "invalid_resources",
    "legacy_reference_counts",
    "mcp_url_conflicts",
    "null_project_references",
    "snapshot_schema_counts"
  ],
  "properties": {
    "credential_type_counts": {"$ref": "#/$defs/counts"},
    "cross_project_references": {"$ref": "#/$defs/entries"},
    "invalid_resources": {"$ref": "#/$defs/entries"},
    "legacy_reference_counts": {"$ref": "#/$defs/counts"},
    "mcp_url_conflicts": {"$ref": "#/$defs/entries"},
    "null_project_references": {"$ref": "#/$defs/entries"},
    "snapshot_schema_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacy-v0", "v1", "v2", "unknown"],
      "properties": {
        "legacy-v0": {"type": "integer", "minimum": 0},
        "v1": {"type": "integer", "minimum": 0},
        "v2": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error_class", "field_path", "resource_id", "surface"],
        "properties": {
          "error_class": {"type": "string", "minLength": 1},
          "field_path": {"type": "string", "minLength": 1},
          "resource_id": {"type": "string", "minLength": 1},
          "surface": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
