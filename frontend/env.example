
# 禁用 Next.js 遥测
NEXT_TELEMETRY_DISABLED=1

# Docker 容器内部配置（Node.js 服务器监听的内部端口，通常不需要修改）
# 对应的宿主机端口在 deploy/.env 的 FRONTEND_PORT_HOST 中配置
FRONTEND_PORT=3000

# 前端服务端认证/邮件开关。真正的认证策略仍以后端配置为准。
DISABLE_REGISTRATION=false
EMAIL_VERIFICATION_ENABLED=false
RESEND_API_KEY=
AZURE_ACS_CONNECTION_STRING=
FROM_EMAIL_ADDRESS=
EMAIL_DOMAIN=

# 后端 API 地址。本地未设置时，前端代码默认连接 http://localhost:8000。
# Docker/生产部署请优先使用 deploy/.env.example 中的统一配置。
NEXT_PUBLIC_API_URL=

# 公开前端地址。用于生成回调、链接和邮件域名；本地未设置时会回退到当前 origin 或 localhost:3000。
NEXT_PUBLIC_APP_URL=

# 浏览器侧上传大小上限，单位 bytes；建议与后端 JOYSAFETER_MAX_UPLOAD_FILE_BYTES 保持一致。
NEXT_PUBLIC_MAX_UPLOAD_FILE_BYTES=52428800

# 登录页是否显示邮箱/密码注册入口。未设置或 false 时不显示。
NEXT_PUBLIC_EMAIL_PASSWORD_SIGNUP_ENABLED=true

# Content Security Policy (CSP) 配置
# 注意：后端 API 同主机的域名已基于 NEXT_PUBLIC_API_URL 自动生成（含端口通配），无需重复配置

# CSP 基础允许域名。生产环境替换为实际域名。
NEXT_PUBLIC_CSP_NECESSARY_DOMAIN=http://localhost:* http://127.0.0.1:*

# 额外 connect-src / frame-src 域名（仅用于添加不同主机 / 第三方域名）
# 示例: NEXT_PUBLIC_CSP_CONNECT_SRC_EXTRA="https://api.third-party.com wss://ws.third-party.com"
NEXT_PUBLIC_CSP_CONNECT_SRC_EXTRA=
NEXT_PUBLIC_CSP_FRAME_SRC_EXTRA=

# CSP 违规上报地址（仅 production 生效）
NEXT_PUBLIC_CSP_REPORT_URI=

# CSP 全局白名单（设置后仅允许白名单内的域名，覆盖其他 CSP 规则）
NEXT_PUBLIC_CSP_WHITELIST=

# 是否允许页面被嵌入 iframe（设为 true 时移除 X-Frame-Options: DENY）
NEXT_PUBLIC_ALLOW_EMBED=false

# 开发环境是否启用 CSP（默认仅 production 启用）
NEXT_PUBLIC_ENABLE_CSP_IN_DEV=false

# 强制 HTTPS 重定向（仅 production 生效）
NEXT_PUBLIC_FORCE_HTTPS=false
